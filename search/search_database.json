y ! the statements that were split need laying out again, unless one of them depends on the ! lines around it do k = 1 , MAX_PASSES split = split_long_lines ( out , opts % line_length , opts % continuation_indent , nsplit , changed ) if ( nsplit == 0 ) exit if ( allocated ( changed ) . and . opts % comment_spacing < 0 ) then out = relayout ( split , changed , opts ) else call format_pass ( split , opts , out , unused ) end if if (. not . too_long ( out , opts % line_length )) exit end do if ( too_long ( out , opts % line_length )) then long = long_code_lines ( out , opts % line_length ) do k = 1 , size ( long ) d = [ d , diagnostic_t ( long ( k ), 'line ' // to_s ( long ( k )) // ' of the formatted file is longer than ' // & to_s ( opts % line_length ) // ' characters and cannot be split' )] end do end if end if if ( opts % comment_spacing >= 0 ) then ! comments are kept where they line up in the input; once the code is formatted, some of ! them may no longer line up, so decide again on the result (which is then stable) split = out call format_pass ( split , opts , out , unused ) end if d = [ limit_diagnostics ( src ), d ] if ( present ( diags )) diags = d stat = FMT_OK ! the tokens of the first pass are those of `src` if sorting and relational spelling changed nothing if ( len ( prepared ) /= len ( src ) . or . prepared /= src ) call tokenize ( src , tokens ) if (. not . same_code ( src , out , opts % sort_use . or . opts % sort_use_only , tokens )) then stat = FMT_ERR_INTERNAL errmsg = 'internal error: formatting would change the code, so the file was left unchanged' out = src end if end subroutine format_text subroutine format_pass ( src , opts , out , diags , src_tokens ) !! One pass of the formatter: structure, whitespace, case and layout. character ( len =* ), intent ( in ) :: src !! source text type ( format_options_t ), intent ( in ) :: opts !! formatting options character ( len = :), allocatable , intent ( out ) :: out !! the formatted text type ( diagnostic_t ), allocatable , intent ( out ) :: diags (:) !! problems found in this pass type ( token_list_t ), intent ( out ), optional :: src_tokens !! the tokens of `src` type ( source_t ) :: source type ( statement_view_t ), allocatable :: views (:) type ( structure_t ) :: st integer , allocatable :: long_lines (:) integer :: k call parse_source ( src , source ) call set_views ( source , views ) call analyze_structure ( source , views , st , diags ) out = layout ( source , st , compute_gaps ( source , views , opts % spaces , opts % comment_spacing ), & compute_case ( source , views , opts % letter_case ), opts , long_lines ) do k = 1 , size ( long_lines ) diags = [ diags , diagnostic_t ( long_lines ( k ), 'indentation kept: the line would be longer than ' // & to_s ( opts % line_length ) // ' characters' )] end do if ( present ( src_tokens )) then call move_alloc ( source % tokens % tok , src_tokens % tok ) src_tokens % n = source % tokens % n end if end subroutine format_pass function limit_diagnostics ( src ) result ( diags ) !! Warnings for input beyond the limits of the Fortran 2023 standard (6.3.2.1): lines longer than !! 10,000 characters, and statements of more than 1,000,000 characters (counted without comments !! and line breaks). character ( len =* ), intent ( in ) :: src !! source text type ( diagnostic_t ), allocatable :: diags (:) integer , parameter :: MAX_LINE = 10000 , MAX_STATEMENT = 1000000 type ( source_t ) :: source integer :: k , j , n , line , width , c allocate ( diags ( 0 )) if ( longest_line ( src ) > MAX_LINE ) then line = 1 width = 0 do k = 1 , len ( src ) c = iand ( ichar ( src ( k : k )), 255 ) if ( c == 10 ) then line = line + 1 width = 0 else if ( c < 128 . or . c >= 192 ) then width = width + 1 if ( width == MAX_LINE + 1 ) diags = [ diags , diagnostic_t ( line , 'line ' // to_s ( line ) // & ' is longer than ' // to_s ( MAX_LINE ) // ' characters, ' // & 'the limit of the Fortran standard' )] end if end do end if if ( len ( src ) <= MAX_ST