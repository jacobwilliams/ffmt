end subroutine set_gap subroutine set_before ( j , mode ) !! Apply rule mode `mode` to the blanks before code token `j`. integer , intent ( in ) :: j !! index into `code(:)` integer , intent ( in ) :: mode !! `WS_KEEP`, `WS_ADD` or `WS_REMOVE` select case ( mode ) case ( WS_ADD ) call set_gap ( j , GAP_MIN1 ) case ( WS_REMOVE ) call set_gap ( j , 0 ) end select end subroutine set_before subroutine around ( j , mode ) !! Apply `mode` on both sides of operator `j`. integer , intent ( in ) :: j !! index into `code(:)` integer , intent ( in ) :: mode !! `WS_KEEP`, `WS_ADD` or `WS_REMOVE` call set_before ( j , mode ) call set_before ( j + 1 , mode ) end subroutine around logical function can_join ( j ) !! True if tokens `j - 1` and `j` keep their meaning when written without a blank between them. integer , intent ( in ) :: j !! index into `code(:)` integer :: ka , kb ka = v % kinds ( j - 1 ) kb = v % kinds ( j ) can_join = . true . if ( is_word ( ka ) . and . is_word ( kb )) can_join = . false . ! `a b`, `1 e5` if ( ka == TK_OP . and . kb == TK_OP ) then ! `* *` would become `**` select case ( v % word ( j - 1 ) // v % word ( j )) case ( '**' , '//' , '==' , '/=' , '<=' , '>=' , '=>' , '::' , '(/' , '/)' ) can_join = . false . end select end if if (( ka == TK_INT . or . ka == TK_REAL ) . and . v % low ( v % lo ( j ): v % lo ( j )) == '.' ) can_join = . false . ! `1 .5` if ( ka == TK_DOTOP . and . kb == TK_DOTOP ) can_join = . false . end function can_join logical function binary ( j ) !! True if operator `j` has an operand on both sides (not unary `-x` or `print *`). integer , intent ( in ) :: j !! index into `code(:)` binary = ends_operand ( j - 1 ) . and . starts_operand ( j + 1 ) end function binary logical function ends_operand ( j ) !! True if code token `j` can end an operand: a name, literal, inline fypp, logical constant, !! `)` or `]`, but not a statement label. integer , intent ( in ) :: j !! index into `code(:)` ends_operand = . false . select case ( v % kind_of ( j )) case ( TK_NAME , TK_INT , TK_REAL , TK_STRING , TK_BOZ , TK_FYPP ) ends_operand = j > v % first . or . v % kinds ( j ) /= TK_INT ! not a statement label case ( TK_DOTOP ) ends_operand = v % is ( j , '.true.' ) . or . v % is ( j , '.false.' ) . or . index ( v % word ( j ), '._' ) > 0 case ( TK_OP ) ends_operand = v % is ( j , ')' ) . or . v % is ( j , ']' ) end select end function ends_operand logical function starts_operand ( j ) !! True if code token `j` can start an operand: a name, literal, inline fypp, dot operator, !! `(`, `[` or a sign. integer , intent ( in ) :: j !! index into `code(:)` starts_operand = . false . select case ( v % kind_of ( j )) case ( TK_NAME , TK_INT , TK_REAL , TK_STRING , TK_BOZ , TK_FYPP , TK_DOTOP ) starts_operand = . true . case ( TK_OP ) starts_operand = v % is ( j , '(' ) . or . v % is ( j , '[' ) . or . v % is ( j , '+' ) . or . v % is ( j , '-' ) end select end function starts_operand logical function type_star ( j ) !! True for the `*` of a length or kind selector: `real*8`, `character*(*)`, `character*10`. integer , intent ( in ) :: j !! index into `code(:)` select case ( v % word ( j - 1 )) case ( 'real' , 'integer' , 'complex' , 'logical' , 'character' , 'precision' ) type_star = . true . case default type_star = . false . end select end function type_star logical function conditional_colon ( j ) !! True if the `:` at `j` belongs to a conditional expression: a `?` comes before it at the same !! bracket depth, inside the same brackets. integer , intent ( in ) :: j !! index into `v%code(:)` of a `:` integer :: k conditional_colon = . false . if ( v % depth ( j ) == 0 ) return do k = j - 1 , 1 , - 1 if ( v % depth ( k ) < v % depth ( j )) return ! the opening bracket if ( v % depth ( k ) == v % depth ( j ) . and . v % is ( k , '?' )) then conditional_colon = . true . return end if end do end function conditional_colon logical function is_control_paren ( j ) !! True if `(` at `j` follows a control keyword: `if (`, `else if (`, `do while (`, !! `select case (`, `where (`, `forall (`, `case (`, `rank (`, `do concurrent (`. integer , intent ( in ) :: j !! index into `code(:)` is_control_paren = . false . if ( j < 2 ) return select case ( v % word ( j - 1 )) case ( 'if' , 'elseif' ) is_control_paren = j - 1 == v % first . or . v % is ( j - 2 , 'else' ) . or . v % is ( j - 2 , ':' ) case ( 'while' , 'concurrent' ) is_control_paren = v % is ( j - 2 , 'do' ) case ( 'case' , 'rank' ) is_control_paren = v % is ( j - 2 , 'select' ) . or . j - 1 == v % first case ( 'type' ) is_control_paren = v % is ( j - 2 , 'select' ) case ( 'selectcase' , 'selecttype' , 'selectrank' , 'where' , 'forall' ) is_control_paren = j - 1 == v % first . or . v % is ( j - 2 , ':' ) end select end function is_control_paren end subroutine statement_gaps elemental logical function is_word ( kind ) !! Tokens that would run together with a following word: names, numbers and BOZ literals. integer , intent ( in ) :: kind !! token kind (`TK_*`) is_word = kind == TK_NAME . or . kind == TK_INT . or . kind == TK_REAL . or . kind == TK_BOZ end function is_word end module ffmt_whitespace","tags":"","url":"sourcefile/ffmt_whitespace.f90.html"},{"title":"ffmt_options.f90 – fformat","text":"Files dependent on this one sourcefile~~ffmt_options.f90~~AfferentGraph sourcefile~ffmt_options.f90 ffmt_options.f90 sourcefile~ffmt_case.f90 ffmt_case.f90 sourcefile~ffmt_case.f90->sourcefile~ffmt_options.f90 sourcefile~ffmt_cli.f90 ffmt_cli.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_options.f90 sourcefile~ffmt_format.f90 ffmt_format.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_format.f90 sourcefile~ffmt_settings.f90 ffmt_settings.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_settings.f90 sourcefile~ffmt_config.f90 ffmt_config.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_config.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_options.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_case.f90 sourcefile~ffmt_layout.f90 ffmt_layout.f90 sourcefile~f