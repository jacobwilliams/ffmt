ion relayout pure logical function too_long ( text , limit ) !! True if a code line of `text` may be longer than `limit` characters (see [[longest_code]]). !! A line has no more characters than bytes, so the scan is only needed when a line has more !! bytes than that, which finding the line breaks shows quickly. character ( len =* ), intent ( in ) :: text !! the formatted text integer , intent ( in ) :: limit !! the line length integer :: p , q too_long = . false . p = 1 do while ( p <= len ( text )) q = index ( text ( p :), achar ( 10 )) if ( q == 0 ) q = len ( text ) - p + 2 if ( q - 1 > limit ) then too_long = longest_code ( text ) > limit return end if p = p + q end do end function too_long pure integer function longest_code ( text ) result ( width ) !! An upper bound of the width of the longest code line of `text`: the characters of each line !! before a comment, without the blanks before it, as [[long_code_lines]] counts them. !! Preprocessor lines do not count. Strings are followed across continuation lines, so that a !! `!` inside one does not end the code, but the scan does not tokenize, so it may count more !! than a token-based count would; never less. character ( len =* ), intent ( in ) :: text !! the formatted text integer :: k , c , w , code_w , last_nonblank character :: quote logical :: line_start , skip , in_comment width = 0 w = 0 code_w = 0 quote = ' ' line_start = . true . skip = . false . in_comment = . false . last_nonblank = 0 do k = 1 , len ( text ) c = iand ( ichar ( text ( k : k )), 255 ) if ( c == 13 . and . k < len ( text )) then if ( text ( k + 1 : k + 1 ) == achar ( 10 )) cycle ! CRLF: the line ends at the LF end if if ( c == 10 . or . c == 13 ) then width = max ( width , code_w ) ! a string continued on the next line ends this one with `&` if ( quote /= ' ' . and . . not . ( last_nonblank > 0 . and . text ( max ( 1 , last_nonblank ): max ( 1 , last_nonblank )) == '&' )) & quote = ' ' w = 0 code_w = 0 line_start = . true . skip = . false . in_comment = . false . last_nonblank = 0 cycle end if if ( skip . or . in_comment ) cycle if ( c >= 128 . and . c < 192 ) cycle ! a UTF-8 continuation byte w = w + 1 if ( text ( k : k ) == ' ' . or . text ( k : k ) == achar ( 9 )) cycle if ( line_start ) then line_start = . false . if ( quote == ' ' . and . ( text ( k : k ) == '#' . or . ( index ( '$@' , text ( k : k )) > 0 . and . & text ( min ( k + 1 , len ( text )): min ( k + 1 , len ( text ))) == ':' ))) then skip = . true . ! a preprocessor line cycle end if end if if ( quote /= ' ' ) then if ( text ( k : k ) == quote ) quote = ' ' ! a doubled quote reopens at once else if ( text ( k : k ) == '\"' . or . text ( k : k ) == \"'\" ) then quote = text ( k : k ) else if ( text ( k : k ) == '!' ) then in_comment = . true . cycle end if code_w = w last_nonblank = k end do width = max ( width , code_w ) end function longest_code pure integer function longest_line ( text ) result ( width ) !! Width of the longest line of `text`, in characters (as [[utf8_width]] counts them). character ( len =* ), intent ( in ) :: text !! text whose lines end with LF integer :: k , c , w width = 0 w = 0 do k = 1 , len ( text ) c = iand ( ichar ( text ( k : k )), 255 ) if ( c == 10 ) then w = 0 else if ( c < 128 . or . c >= 192 ) then w = w + 1 width = max ( width , w ) end if end do end function longest_line logical function same_code ( a , b , reordered_use , a_tokens ) !! True if `a` and `b` have the same code tokens, in the same order, with the same text and the !! same joins across line breaks (blanks, comments and line layout may differ). Names and dot !! operators are compared ignoring case, as Fortran does, and the two spellings of a relational !! operator (`<` and `.lt.`) are the same. !! !! With `reordered_use`, `use` statements may also be in a different order within a run of them !! (not across other statements or preprocessor lines), and so may the items of an `only:` list. character ( len =* ), intent ( in ) :: a !! first source text character ( len =* ), intent ( in ) :: b !! second source text logical , intent ( in ), optional :: reordered_use !! allow reordered `use` statements; default false type ( token_list_t ), intent ( in ), optional :: a_tokens !! the tokens of `a`, if already known type ( token_list_t ) :: ta , tb if ( present ( reordered_use )) then if ( reordered_use ) then same_code = code_signature ( a ) == code_signature ( b ) return end if end if ! token by token, without building signatures call tokenize ( b , tb ) if ( present ( a_tokens )) then same_code = same_lists ( a_tokens ) ! without a copy of the token list else call tokenize ( a , ta ) same_code = same_lists ( ta ) end if contains logical function same_lists ( ta ) !! True if the code tokens of `a` (`ta`) match those of `b` (`tb`). type ( token_list_t ), intent ( in ) :: ta !! the tokens of `a` integer :: i , j same_lists = . false . i = 0 j = 0 do i = next_code ( ta , i ) j = next_code ( tb , j ) if ( i > ta % n . or . j > tb % n ) exit if (. not . same_token ( a , ta % tok ( i ), b , tb % tok ( j ))) return end do same_lists = i > ta % n . and . j > tb % n end function same_lists pure integer function next_code ( tokens , k ) result ( next ) !! The index of the first code token after token `k`, or `tokens%n + 1`. type ( token_list_t ), intent ( in ) :: tokens !! the token list integer , intent ( in ) :: k !! index into `tokens`, or 0 to start at the beginning next = k + 1 do while ( next <= tokens % n ) if ( is_code_kind ( tokens % tok ( next )% kind )) return next = next + 1 end do end function next_code end function same_code pure logical function same_token ( sa , s , sb , t ) !! True if code token `s` of `sa` matches code token `t` of `sb`, as their keys in !! [[code_signature]] would: same kind (operators all alike), same glue, and the same text, !! ignoring case where Fortran does (see [[folded_length]]), with relational operators in their !! symbol spelling. character ( len =* ), intent ( in ) :: sa !! source text of `s` character ( len =* ), intent ( in ) :: sb !! source text of `t` type ( token_t ), intent ( in ) :: s !! a code token of `sa` type ( token_t ), intent ( in ) :: t !! a code token of `sb` integer :: ks , kt , k , nfold character ( len = :), allocatable :: ca , cb ks = s % kind kt = t % kind if ( ks == TK_DOTOP ) ks = TK_OP if ( kt == TK_DOTOP ) kt = TK_OP same_token = . false . if ( ks /= kt . or . ( s % glued . neqv . t % glued )) return if ( s % last - s % first == t % last - t % first ) then nfold = folded_length ( sa ( s % first : s % last ), s % kind ) same_token = . true . do k = 0 , s % last - s % first if ( k < nfold ) then if ( lower_char ( sa ( s % first + k : s % first + k )) == lower_char ( sb ( t % first + k : t % first + k ))) cycle else if ( sa ( s % first + k : s % first + k ) == sb ( t % first + k : t % first + k )) cycle end if same_token = . false . exit end do if ( same_token ) return end if ! `.lt.` and `<`: rare, so the allocating comparison is fine here if ( ks == TK_OP ) then ca = canonical_relational ( token_lower ( sa , s )) cb = canonical_relational ( token_lower ( sb , t )) same_token = len ( ca ) == len ( cb ) . and . ca == cb end if end function same_token pure integer function folded_length ( text , kind ) result ( n ) !! How much of a token's text, from its start, Fortran reads ignoring case: all of a name, an !! operator or a number (exponent letters and kinds), the kind prefix of a string, and none of !! anything else. character ( len =* ), intent ( in ) :: text !! the token's text integer , intent ( in ) :: kind !! its kind (`TK_*`) select case ( kind ) case ( TK_NAME , TK_OP , TK_DOTOP , TK_INT , TK_REAL ) n = len ( text ) case ( TK_STRING ) n = max ( 0 , scan ( text , '\"' // \"'\" ) - 1 ) case default n = 0 end select end function folded_length function code_signature ( src ) result ( sig ) !! The code tokens of `src` as one string that [[same_code]] compares when `use` statements may !! be reordered: for each token its kind (operators all alike), whether it is glued to the !! previous token, and its text as `key` gives it. The signatures of `use` statements in a run !! are sorted, and so are those of the items of each `only:` list. character ( len =* ), intent ( in ) :: src !! source text character ( len = :), allocatable :: sig type ( source_t ) :: source type ( statement_view_t ) :: v type ( string_builder_t ) :: buf type ( string_t ), allocatable :: run (:) type ( string_t ) :: item integer :: k , j call parse_source ( src , source ) allocate ( run ( 0 )) associate ( tokens => source % tokens , stmts => source % stmts ) do k = 1 , stmts % n if ( stmts % s ( k )% kind == SK_PREPROC ) call flush_run () if ( stmts % s ( k )% kind /= SK_CODE ) cycle call set_view ( src , tokens , stmts % s ( k ), v ) if ( is_use_statement ( v )) then ! through a variable: a gfortran 15 internal compiler error otherwise item % s = use_signature ( stmts % s ( k ), v ) run = [ run , item ] else call flush_run () do j = stmts % s ( k )% first , stmts % s ( k )% last if ( is_code_kind ( tokens % tok ( j )% kind )) call buf % append ( key ( tokens % tok ( j ))) end do end if end do end associate call flush_run () sig = buf % get () contains subroutine flush_run () !! Append the signatures of the pending run of `use` statements, sorted, and empty the run. integer , allocatable :: order (:) integer :: p order = sorted_order ( run ) do p = 1 , size ( order ) call buf % append ( run ( order ( p ))% s ) end do deallocate ( run ) allocate ( run ( 0 )) end subroutine flush_run function use_signature ( stmt , v ) result ( s ) !! Signature of a `use` statement, with the items of its `only:` list sorted. Any `;` that !! ends it comes last. type ( statement_t ), intent ( in ) :: stmt !! the `use` statement type ( statement_view_t ), intent ( in ) :: v !! its view character ( len = :), allocatable :: s integer , allocatable :: starts (:), ends (:), order (:) type ( string_t ), allocatable :: items (:) integer :: p , q , first starts = only_items ( v ) first = v % n + 1 if ( size ( starts ) > 0 ) first = starts ( 1 ) s = '' do p = 1 , first - 1 s = s // key ( source % tokens % tok ( v % code ( p ))) end do if ( size ( starts ) > 0 ) then ends = [ starts ( 2 :) - 2 , v % n ] allocate ( items ( size ( starts ))) do p = 1 , size ( starts ) items ( p )% s = '' do q = starts ( p ), ends ( p ) items ( p )% s = items ( p )% s // key ( source % tokens % tok ( v % code ( q ))) end do end do order = sorted_order ( items ) do p = 1 , size ( order ) s = s // items ( order ( p ))% s if ( p < size ( order )) s = s // key ( source % tokens % tok ( v % code ( starts ( 2 ) - 1 ))) ! the comma end do end if do p = stmt % first , stmt % last if ( source % tokens % tok ( p )% kind == TK_OP ) then if ( token_text ( src , source % tokens % tok ( p )) == ';' ) s = s // key ( source % tokens % tok ( p )) end if end do end function use_signature function key ( t ) result ( k ) !! What must match: the kind, the glue, and the text, ignoring case for names and operators, !! with relational operators in their symbol spelling. The length is included, since `==` !! pads with blanks. type ( token_t ), intent ( in ) :: t !! a code token of `src` character ( len = :), allocatable :: k character :: kind , glue select case ( t % kind ) case ( TK_DOTOP , TK_OP ) k = canonical_relational ( token_lower ( src , t )) case default k = token_text ( src , t ) associate ( n => folded_length ( k , t % kind )) k ( 1 : n ) = lowercase ( k ( 1 : n )) end associate end select kind = achar ( 64 + t % kind ) if ( t % kind == TK_DOTOP ) kind = achar ( 64 + TK_OP ) glue = merge ( 'g' , ' ' , t % glued ) k = kind // glue // to_s ( len ( k )) // ':' // k end function key end function code_signature end module ffmt_format","tags":"","url":"sourcefile/ffmt_format.f90.html"},{"title":"ffmt_config.f90 – fformat","text":"This file depends on sourcefile~~ffmt_config.f90~~EfferentGraph sourcefile~ffmt_config.f90 ffmt_config.f90 sourcefile~ffmt_fs.f90 ffmt_fs.f90 sourcefile~ffmt_config.f90->sourcefile~ffmt_fs.f90 sourcefile~ffmt_settings.f90 ffmt_settings.f90 sourcefile~ffmt_config.f90->sourcefile~ffmt_settings.f90 sourcefile~ffmt_strings.f90 ffmt_strings.f90 sourcefile~ffmt_config.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_settings.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_options.f90 ffmt_options.f90 sourcefile~ffmt_settings.f90->sourcefile~ffmt_options.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~ffmt_config.f90~~AfferentGraph sourcefile~ffmt_config.f90 ffmt_config.f90 sourcefile~ffmt_cli.f90 ffmt_cli.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_config.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code module ffmt_config !! Configuration files. !! !! Settings (see [[ffmt_settings]]) are read from the nearest of these, searching from a file's !! directory upward: !! !! * `.fformat.toml` !! * `fpm.toml`, in an `[extra.fformat]` table !! !! Settings are written as in the table of [[ffmt_settings]], with `spaces` and `case` as tables: !! !! ```toml !! indent = 3 !! line-length = 100 !! [spaces] !! comma = \"add\" !! [case] !! keywords = \"lower\" !! [files] !! extensions = [\"f90\", \"F90\"] !! exclude = [\"build\", \"legacy/*.f90\"] !! ``` !! !! The `[files]` table controls which files are formatted when a directory is given. use tomlf , only : toml_table , toml_array , toml_keyval , toml_key , toml_value , toml_error , toml_load , get_value , len use tomlf_constants , only : toml_type use ffmt_settings , only : setting_t use ffmt_fs , only : join_path , parent_directory use ffmt_strings , only : to_s , string_t implicit none private public :: find_config , load_config character ( len =* ), parameter :: CONFIG_NAME = '.fformat.toml' type , public :: config_t !! The settings of one configuration file. character ( len = :), allocatable :: path !! the file, or `''` if there is none type ( setting_t ), allocatable :: settings (:) !! the formatting settings, in the order they are applied type ( string_t ), allocatable :: extensions (:) !! `files.extensions`; not allocated if the file does not set it type ( string_t ), allocatable :: exclude (:) !! `files.exclude`, likewise end type config_t contains subroutine find_config ( dir , cfg , stat , errmsg ) !! The configuration for files in directory `dir` (an absolute path): from the nearest config file !! in `dir` or its parents. `cfg%path` is `''` if there is none. character ( len =* ), intent ( in ) :: dir !! absolute path of the directory type ( config_t ), intent ( out ) :: cfg !! the configuration found integer , intent ( out ) :: stat !! nonzero if the config file found cannot be read character ( len = :), allocatable , intent ( out ) :: errmsg !! what is wrong, with the file name, if `stat` is nonzero character ( len = :), allocatable :: d , candidate logical :: exists , found stat = 0 d = dir do while ( len ( d ) > 0 ) candidate = join_path ( d , CONFIG_NAME ) inquire ( file = candidate , exist = exists ) if ( exists ) then call load_config ( candidate , . false ., cfg , found , stat , errmsg ) return end if candidate = join_path ( d , 'fpm.toml' ) inquire ( file = candidate , exist = exists ) if ( exists ) then call load_config ( candidate , . true ., cfg , found , stat , errmsg ) if ( found . or . stat /= 0 ) return end if if ( parent_directory ( d ) == d ) exit d = parent_directory ( d ) end do call empty ( cfg ) end subroutine find_config subroutine load_config ( path , fpm , cfg , found , stat , errmsg ) !! Read the configuration in file `path`: the whole file, or with `fpm` its !! `[extra.fformat]` table. `found` is false if an `fpm.toml` has no such table. character ( len =* ), intent ( in ) :: path !! the TOML file logical , intent ( in ) :: fpm !! `path` is an `fpm.toml` type ( config_t ), intent ( out ) :: cfg !! the configuration; empty if not `found` logical , intent ( out ) :: found !! the file has a configuration integer , intent ( out ) :: stat !! nonzero for bad TOML, an unknown key or a bad value character ( len = :), allocatable , intent ( out ) :: errmsg !! what is wrong, with the file name, if `stat` is nonzero type ( toml_table ), allocatable , target :: top type ( toml_table ), pointer :: extra , table type ( toml_error ), allocatable :: error stat = 0 found = . false . call empty ( cfg ) call toml_load ( top , path , error = error ) if ( allocated ( error )) then stat = 1 errmsg = path // ': ' // error % message return end if if ( fpm ) then call get_value ( top , 'extra' , extra , requested = . false .) if (. not . associated ( extra )) return call get_value ( extra , 'fformat' , table , requested = . false .) if (. not . associated ( table )) return else table => top end if found = . true . cfg % path = path call read_table ( table , '' ) contains recursive subroutine read_table ( t , prefix ) !! Add the settings in table `t`, with keys prefixed by `prefix`. type ( toml_table ), intent ( inout ) :: t !! the table to read character ( len =* ), intent ( in ) :: prefix !! `''` for the top level, or `spaces.` / `case.` type ( toml_key ), allocatable :: keys (:) class ( toml_value ), pointer :: v type ( toml_table ), pointer :: sub character ( len = :), allocatable :: key , text integer :: k call t % get_keys ( keys ) do k = 1 , size ( keys ) key = keys ( k )% key call t % get ( key , v ) select type ( v ) type is ( toml_table ) sub => v if ( prefix == '' . and . key == 'files' ) then call read_files ( sub ) else if ( prefix == '' . and . ( key == 'spaces' . or . key == 'case' )) then call read_table ( sub , key // '.' ) else call bad ( 'unknown table \"' // prefix // key // '\"' ) end if type is ( toml_keyval ) text = value_text ( t , key , v % get_type ()) if ( stat /= 0 ) return ! `all` comes first, so that the other entries of the table override it if ( key == 'all' ) then cfg % settings = [ setting_t ( prefix // key , text ), cfg % settings ] else cfg % settings = [ cfg % settings , setting_t ( prefix // key , text )] end if class default call bad ( 'unexpected value for \"' // prefix // key // '\"' ) end select if ( stat /= 0 ) return end do end subroutine read_table function value_text ( t , key , kind ) result ( text ) !! A string, integer or boolean value as text. type ( toml_table ), intent ( inout ) :: t !! the table holding the value character ( len =* ), intent ( in ) :: key !! the value's key in `t` integer , intent ( in ) :: kind !! the value's type, a `toml_type` member character ( len = :), allocatable :: text integer :: i logical :: flag text = '' if ( kind == toml_type % string ) then call get_value ( t , key , text ) else if ( kind == toml_type % int ) then call get_value ( t , key , i ) text = to_s ( i ) else if ( kind == toml_type % boolean ) then call get_value ( t , key , flag ) text = merge ( 'true ' , 'false' , flag ) text = trim ( text ) else call bad ( 'expected a string, number or true/false for \"' // key // '\"' ) end if end function value_text subroutine read_files ( t ) !! Read the `[files]` table `t` into `cfg%extensions` and `cfg%exclude`. type ( toml_table ), intent ( inout ) :: t !! the `[files]` table type ( toml_key ), allocatable :: keys (:) integer :: k call t % get_keys ( keys ) do k = 1 , size ( keys ) select case ( keys ( k )% key ) case ( 'extensions' ) call read_list ( t , 'extensions' , cfg % extensions ) case ( 'exclude' ) call read_list ( t , 'exclude' , cfg % exclude ) case default call bad ( 'unknown setting \"files.' // keys ( k )% key // '\"' ) end select if ( stat /= 0 ) return end do end subroutine read_files subroutine read_list ( t , key , list ) !! An array of strings. type ( toml_table ), intent ( inout ) :: t !! the `[files]` table character ( len =* ), intent ( in ) :: key !! the array's key in `t` type ( string_t ), allocatable , intent ( inout ) :: list (:) !! the strings, replacing any earlier list type ( toml_array ), pointer :: arr character ( len = :), allocatable :: item integer :: i , ios call get_value ( t , key , arr , requested = . false .) if (. not . associated ( arr )) then call bad ( 'expected a list of strings for \"files.' // key // '\"' ) return end if if ( allocated ( list )) deallocate ( list ) allocate ( list ( 0 )) do i = 1 , len ( arr ) call get_value ( arr , i , item , stat = ios ) if ( ios /= 0 . or . . not . allocated ( item )) then call bad ( 'expected a list of strings for \"files.' // key // '\"' ) return end if list = [ list , string_t ( item )] end do end subroutine read_list subroutine bad ( msg ) !! Make loading fail with message `msg`, prefixed with the file name. character ( len =* ), intent ( in ) :: msg !! what is wrong stat = 1 errmsg = path // ': ' // msg end subroutine bad end subroutine load_config subroutine empty ( cfg ) !! A configuration with nothing set. type ( config_t ), intent ( out ) :: cfg !! set to have no file, no settings and no `[files]` lists cfg % path = '' allocate ( cfg % settings ( 0 )) end subroutine empty end module ffmt_config","tags":"","url":"sourcefile/ffmt_config.f90.html"},{"title":"ffmt_layout.f90 – fformat","text":"This file depends on sourcefile~~ffmt_layout.f90~~EfferentGraph sourcefile~ffmt_layout.f90 ffmt_layout.f90 sourcefile~ffmt_case.f90 ffmt_case.f90 sourcefile~ffmt_layout.f90->sourcefile~ffmt_case.f90 sourcefile~ffmt_options.f90 ffmt_options.f90 sourcefile~ffmt_layout.f90->sourcefile~ffmt_options.f90 sourcefile~ffmt_source.f90 ffmt_source.f90 sourcefile~ffmt_layout.f90->sourcefile~ffmt_source.f90 sourcefile~ffmt_statements.f90 ffmt_statements.f90 sourcefile~ffmt_layout.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_strings.f90 ffmt_strings.f90 sourcefile~ffmt_layout.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_structure.f90 ffmt_structure.f90 sourcefile~ffmt_layout.f90->sourcefile~ffmt_structure.f90 sourcefile~ffmt_tokens.f90 ffmt_tokens.f90 sourcefile~ffmt_layout.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_whitespace.f90 ffmt_whitespace.f90 sourcefile~ffmt_layout.f90->sourcefile~ffmt_whitespace.f90 sourcefile~ffmt_case.f90->sourcefile~ffmt_options.f90 sourcefile~ffmt_case.f90->sourcefile~ffmt_source.f90 sourcefile~ffmt_case.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_case.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_directives.f90 ffmt_directives.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_directives.f90 sourcefile~ffmt_lexer.f90 ffmt_lexer.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_lexer.f90 sourcefile~ffmt_statements.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_statements.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_structure.f90->sourcefile~ffmt_source.f90 sourcefile~ffmt_structure.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_structure.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_structure.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_constructs.f90 ffmt_constructs.f90 sourcefile~ffmt_structure.f90->sourcefile~ffmt_constructs.f90 sourcefile~ffmt_tokens.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_whitespace.f90->sourcefile~ffmt_options.f90 sourcefile~ffmt_whitespace.f90->sourcefile~ffmt_source.f90 sourcefile~ffmt_whitespace.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_whitespace.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_whitespace.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_constructs.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_constructs.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_constructs.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_directives.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_directives.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_lexer.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_lexer.f90->sourcefile~ffmt_tokens.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~ffmt_layout.f90~~AfferentGraph sourcefile~ffmt_layout.f90 ffmt_layout.f90 sourcefile~ffmt_format.f90 ffmt_format.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_layout.f90 sourcefile~ffmt_cli.f90 ffmt_cli.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_format.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code module ffmt_layout !! Writes the formatted text of a tokenized file: statements indented by their nesting depth, !! continuation lines aligned or indented by a fixed amount, comment lines indented like the code !! around them, and within each line the blanks and letter case that [[compute_gaps]] and !! [[compute_case]] ask for. Trailing blanks are removed. !! !! Items protected by formatter directives (see [[ffmt_directives]]) are written as they are. use ffmt_tokens use ffmt_statements use ffmt_source , only : source_t use ffmt_structure , only : structure_t use ffmt_options use ffmt_whitespace , only : GAP_KEEP , GAP_MIN1 use ffmt_case , only : case_marks_t , kind_part use ffmt_strings , only : string_builder_t , utf8_width implicit none private public :: layout type :: writer_t !! Output being built, and the alignment state of the current statement. type ( string_builder_t ) :: buf !! the output text integer :: col = 0 !! output column: characters since the last line break integer :: nbrackets = 0 !! open brackets in the current statement integer , allocatable :: bracket_first (:) !! column of the first item after each open bracket, or -1; !! only `bracket_first(1:nbrackets)` is in use integer :: anchor_col ( 3 ) = - 1 !! column of the first item after an assignment `=` / `=>`, !! a `use` statement's `only:` and a declaration's `::`, or -1 integer :: pending_anchor = 0 !! the next code token is the first item after this anchor logical :: pending_bracket = . false . !! the next code token is the first item after a bracket logical :: separated = . false . !! a top-level `,` or `:` has been seen in the statement integer :: prev = 0 !! the previous code token of the statement (index into the !! token list), or 0 integer :: comment_in = - 1 !! input column of the comment on the previous line, or -1 integer :: comment_out = - 1 !! output column of that comment logical :: line_comment = . false . !! a comment has been written on the current line integer :: stmt_in = - 1 !! input column of the last statement, while comment lines !! directly follow it, or -1 integer :: stmt_out = - 1 !! output column of that statement logical :: generic = . false . !! the current statement is a `generic` binding logical :: declaration = . false . !! a top-level `::` has been seen in the current statement integer :: line_length = 0 !! maximum line length, or 0 logical :: keep_original = . true . !! fall back to a code line's original indentation when the !! new one would make it too long (when lines are not split) integer , allocatable :: long_lines (:) !! input lines that kept their indentation to stay within the line length integer , allocatable :: gap (:) !! blanks wanted before each token (see [[compute_gaps]]) type ( case_marks_t ) :: cases !! letter case wanted for each token (see [[compute_case]]) end type writer_t type :: piece_t !! A piece of an output line: a token, or the blanks before one. Its text is `src(first:last)` !! (with the token's letter case applied), or `blanks` blanks if that is positive; it is not !! copied, so that measuring a line allocates nothing. integer :: tok = 0 !! token index, or 0 for blanks integer :: first = 1 !! first byte of the text in the source integer :: last = 0 !! last byte of the text in the source integer :: blanks = 0 !! if positive, the piece is this many blanks instead end type piece_t ! anchors for aligning continuation lines outside brackets, in order of preference integer , parameter :: ANCHOR_ASSIGN = 1 , ANCHOR_ONLY = 2 , ANCHOR_DECL = 3 contains function layout ( source , st , gap , cases , opts , long_lines ) result ( out ) !! The formatted text of `source`, from its structure ([[analyze_structure]]), the gaps !! ([[compute_gaps]]) and the letter case ([[compute_case]]) wanted. type ( source_t ), intent ( in ) :: source !! the source type ( structure_t ), intent ( in ) :: st !! its block structure integer , intent ( in ) :: gap (:) !! blanks wanted before each token type ( case_marks_t ), intent ( in ) :: cases !! letter case wanted for each token type ( format_options_t ), intent ( in ) :: opts !! the formatting options integer , allocatable , intent ( out ), optional :: long_lines (:) !! input lines that kept their indentation !! because the new one would make them longer !! than `opts%line_length` character ( len = :), allocatable :: out type ( writer_t ) :: w integer :: k , level , ind w % line_length = opts % line_length w % keep_original = . not . opts % split_lines w % gap = gap w % cases = cases allocate ( w % long_lines ( 0 )) associate ( src => source % text , tokens => source % tokens ) do k = 1 , source % stmts % n level = st % depth ( k ) if (. not . opts % indent_units ) level = level - st % units ( k ) if (. not . opts % indent_procedures ) level = level - st % procedures ( k ) if ( opts % indent_fypp ) level = level + st % fypp ( k ) ind = opts % base_indent + max ( level , 0 ) * opts % indent associate ( s => source % stmts % s ( k )) if ( source % keep ( k )) then ! a formatter directive: written as it is call emit_range ( w , src , tokens , s % first , s % last ) w % comment_in = - 1 w % stmt_in = - 1 cycle end if select case ( s % kind ) case ( SK_BLANK ) call emit_blank ( w , src , tokens , s ) w % comment_in = - 1 w % stmt_in = - 1 case ( SK_PREPROC ) if ( opts % indent_fypp ) then call emit_fypp_line ( w , src , tokens , s , ind ) else call emit_range ( w , src , tokens , s % first , s % last ) end if w % comment_in = - 1 case ( SK_COMMENT ) call emit_comment_line ( w , src , tokens , s , ind , opts ) case ( SK_CODE ) call emit_statement ( w , src , tokens , s , st % info ( k )% label > 0 , ind , opts ) end select end associate end do end associate out = w % buf % get () if ( present ( long_lines )) long_lines = w % long_lines end function layout integer function fitting_column ( w , src , tokens , f , lend , candidates , from , prefix , always_original ) result ( col ) !! The first of the `candidates` columns at which the output line fits within the line length, or !! the smallest if none fits. The last candidate is the line's original column: if only that one !! fits, the line is recorded in `long_lines`. When lines are split (`w%keep_original` false), the !! original column is not a candidate for code, since splitting will make the line fit; it is !! still used if `always_original` is true (for comments, which are not split). Also when lines are !! split, a candidate other than the last is accepted if the line can be split to fit there: if !! its first piece up to a possible break fits. !! !! The input line starts with token `f`. The output line is `prefix` characters (e.g. `& ` for a !! leading continuation marker) followed by tokens `from:lend` (default `f:lend`). type ( writer_t ), in