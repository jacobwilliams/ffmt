eordered_use !! allow reordered `use` statements; default false type ( token_list_t ), intent ( in ), optional :: a_tokens !! the tokens of `a`, if already known type ( token_list_t ) :: ta , tb if ( present ( reordered_use )) then if ( reordered_use ) then same_code = code_signature ( a ) == code_signature ( b ) return end if end if ! token by token, without building signatures call tokenize ( b , tb ) if ( present ( a_tokens )) then same_code = same_lists ( a_tokens ) ! without a copy of the token list else call tokenize ( a , ta ) same_code = same_lists ( ta ) end if contains logical function same_lists ( ta ) !! True if the code tokens of `a` (`ta`) match those of `b` (`tb`). type ( token_list_t ), intent ( in ) :: ta !! the tokens of `a` integer :: i , j same_lists = . false . i = 0 j = 0 do i = next_code ( ta , i ) j = next_code ( tb , j ) if ( i > ta % n . or . j > tb % n ) exit if (. not . same_token ( a , ta % tok ( i ), b , tb % tok ( j ))) return end do same_lists = i > ta % n . and . j > tb % n end function same_lists pure integer function next_code ( tokens , k ) result ( next ) !! The index of the first code token after token `k`, or `tokens%n + 1`. type ( token_list_t ), intent ( in ) :: tokens !! the token list integer , intent ( in ) :: k !! index into `tokens`, or 0 to start at the beginning next = k + 1 do while ( next <= tokens % n ) if ( is_code_kind ( tokens % tok ( next )% kind )) return next = next + 1 end do end function next_code end function same_code","tags":"","url":"proc/same_code.html"},{"title":"same_token – fformat","text":"private pure function same_token(sa, s, sb, t) True if code token s of sa matches code token t of sb , as their keys in code_signature would: same kind (operators all alike), same glue, and the same text,\nignoring case where Fortran does (see folded_length ), with relational operators in their\nsymbol spelling. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: sa source text of s type