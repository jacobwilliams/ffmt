or add Subroutines public  subroutine apply_setting (opts, key, value, stat, errmsg) Apply one setting to opts . stat is nonzero, with a message, for an unknown setting or a bad value. Arguments Type Intent Optional Attributes Name type( format_options_t ), intent(inout) :: opts the options to change character(len=*), intent(in) :: key setting name, as in the table above character(len=*), intent(in) :: value its value as text integer, intent(out) :: stat 0, or 1 for an unknown setting or a bad value character(len=:), intent(out), allocatable :: errmsg what is wrong, if stat is nonzero","tags":"","url":"module/ffmt_settings.html"},{"title":"ffmt_relational – fformat","text":"Spelling of the relational operators: == / .eq. , /= / .ne. , < / .lt. , <= / .le. , > / .gt. and >= / .ge. . The two spellings are the same operator, also in operator(...) . CUDA kernel launches ( <<< ... >>> ) and code protected by formatter directives are not changed. Uses ffmt_tokens ffmt_statements ffmt_source ffmt_strings ffmt_options module~~ffmt_relational~~UsesGraph module~ffmt_relational ffmt_relational module~ffmt_options ffmt_options module~ffmt_relational->module~ffmt_options module~ffmt_source ffmt_source module~ffmt_relational->module~ffmt_source module~ffmt_statements ffmt_statements module~ffmt_relational->module~ffmt_statements module~ffmt_strings ffmt_strings module~ffmt_relational->module~ffmt_strings module~ffmt_tokens ffmt_tokens module~ffmt_relational->module~ffmt_tokens module~ffmt_source->module~ffmt_statements module~ffmt_source->module~ffmt_tokens module~ffmt_directives ffmt_directives module~ffmt_source->module~ffmt_directives module~ffmt_lexer ffmt_lexer module~ffmt_source->module~ffmt_lexer module~ffmt_statements->module~ffmt_strings module~ffmt_statements->module~ffmt_tokens module~ffmt_tokens->module~ffmt_strings module~ffmt_directives->module~ffmt_statements module~ffmt_directives->module~ffmt_tokens module~ffmt_lexer->module~ffmt_strings module~ffmt_lexer->module