 x /1/`, `common /blk/ a`, ...: slashes are delimiters, not division select case ( v % word ( v % first )) case ( 'data' , 'common' , 'namelist' , 'save' , 'equivalence' ) slash_lists = . true . case default slash_lists = . false . end select do i = 1 , v % n if ( v % kinds ( i ) == TK_OP ) then associate ( t => v % low ( v % lo ( i ): v % hi ( i ))) select case ( t ) case ( '(' ) if ( is_control_paren ( i )) call set_before ( i , ws % control_paren ) case ( '=' ) if ( v % depth ( i ) == 0 ) then call around ( i , ws % assignment ) else call around ( i , ws % keyword_args ) end if case ( '=>' ) call around ( i , ws % pointer ) case ( '::' ) call around ( i , ws % declarations ) case ( '==' , '/=' , '<=' , '>=' ) call around ( i , ws % relational ) case ( '<' , '>' ) if (. not . is_chevron ( src , tokens , v % code ( i ))) call around ( i , ws % relational ) case ( '+' , '-' ) if ( binary ( i )) call around ( i , ws % plus_minus ) case ( '*' ) if ( binary ( i ) . and . . not . type_star ( i )) call around ( i , ws % mult_div ) case ( '/' ) if ( binary ( i ) . and . . not . slash_lists ) call around ( i , ws % mult_div ) case ( '**' ) if ( binary ( i )) call around ( i , ws % power ) case ( '//' ) if ( binary ( i ) . and . . not . slash_lists ) call around ( i , ws % concat ) case ( '%' ) call around ( i , ws % percent ) case ( '?' ) call around ( i , ws % conditional ) case ( ':' ) if ( conditional_colon ( i )) then call around ( i , ws % conditional ) else if ( v % depth ( i ) > 0 ) then ! a slice `a(1 : n, :)`: only between the colon and its bounds if ( ends_operand ( i - 1 )) call set_before ( i , ws % slice_colon ) if ( starts_operand ( i + 1 )) call set_before ( i + 1 , ws % slice_colon ) end if case ( ',' ) select case ( ws % comma ) case ( WS_ADD ) call set_gap ( i , 0 ) call set_gap ( i + 1 , GAP_MIN1 ) case ( WS_REMOVE ) call set_gap ( i , 0 ) call set_gap ( i + 1 , 0 ) end select end select end associate else if ( v % kinds ( i ) == TK_NAME ) then ! `if (x)then`: the blank before a final `then` goes with the one before the condition if ( i == v % n . and . v % is ( i , 'then' ) . and . v % is ( i - 1 , ')' )) call set_before ( i , ws % control_paren ) else if ( v % kinds ( i ) == TK_DOTOP ) then select case ( v % word ( i )) case ( '.eq.' , '.ne.' , '.lt.' , '.le.' , '.gt.' , '.ge.' ) call around ( i , ws % relational ) case ( '.and.' , '.or.' , '.eqv.' , '.neqv.' ) call around ( i , ws % logical ) case ( '.not.' , '.true.' , '.false.' ) continue case default ! a user-defined operator, unless it is a logical constant with a kind (`.true._lk`) if ( index ( v % word ( i ), '._' ) == 0 . and . binary ( i )) call around ( i , ws % defined_operators ) end select end if end do contains logical function adjacent ( j ) !! True if code tokens `j - 1` and `j` are on the same line with only blanks between them. integer , intent ( in ) :: j !! index into `code(:)` integer :: k adjacent = . false . if ( j < 2 . or . j > v % n ) return if ( tokens % tok ( v % code ( j ))% glued ) return do k = v % code ( j - 1 ) + 1 , v % code ( j ) - 1 if ( tokens % tok ( k )% kind /= TK_SPACE ) return end do adjacent = . true . end function adjacent subroutine set_gap ( j , g ) !! Ask for gap `g` before code token `j`, if it is on the same line as the previous token and the !! two tokens can be written next to each other without becoming different tokens. integer , intent ( in ) :: j !! index into `code(:)` integer , intent ( in ) :: g !! the gap: `GAP_MIN1` or a number of blanks if (. not . adjacent ( j )) return if ( g == 0 . and . . not . can_join ( j )) return gap ( v % code ( j )) = g end subroutine set_gap subroutine set_before ( j , mode ) !! Apply rule mode `mode` to the blanks before code token `j`. integer , intent ( in ) :: j !! index into `code(:)` integer , intent ( in ) :: mode !! `WS_KEEP`, `WS_ADD` or `WS_REMOVE` select case ( mode ) case ( WS_ADD ) call set_gap ( j , GAP_MIN1 ) case ( WS_REMOVE ) call set_gap ( j , 0 ) end select end subroutine set_before subroutine around ( j , mode ) !! Apply `mode` on both sides of operator `j`. integer , intent ( in ) :: j !! index into `code(:)` integer , intent ( in ) :: mode !! `WS_KEEP`, `WS_ADD` or `WS_REMOVE` call set_before ( j , mode ) call set_before ( j + 1 , mode ) end subroutine around logical function can_join ( j ) !! True if tokens `j - 1` and `j` keep their meaning when written without a blank between them. integer , intent ( in ) :: j !! index into `code(:)` integer :: ka , kb ka = v % kinds ( j - 1 ) kb = v % kinds ( j ) can_join = . true . if ( is_word ( ka ) . and . is_word ( kb )) can_join = . false . ! `a b`, `1 e5` if ( ka == TK_OP . and . kb == TK_OP ) then ! `* *` would become `**` select case ( v % word ( j - 1 ) // v % word ( j )) case ( '**' , '//' , '==' , '/=' , '<=' , '>=' , '=>' , '::' , '(/' , '/)' ) can_join = . false . end select end if if (( ka == TK_INT . or . ka == TK_REAL ) . and . v % low ( v % lo ( j ): v % lo ( j )) == '.' ) can_join = . false . ! `1 .5` if ( ka == TK_DOTOP . and . kb == TK_DOTOP ) can_join = . false . end function can_join logical function binary ( j ) !! True if operator `j` has an operand on both sides (not unary `-x` or `print *`). integer , intent ( in ) :: j !! index into `code(:)` binary = ends_operand ( j - 1 ) . and . starts_operand ( j + 1 ) end function binary logical function ends_operand ( j ) !! True if code token `j` can end an operand: a name, literal, inline fypp, logical constant, !! `)` or `]`, but not a statement label. integer , intent ( in ) :: j !! index into `code(:)` ends_operand = . false . select case ( v % kind_of ( j )) case ( TK_NAME , TK_INT , TK_REAL , TK_STRING , TK_BOZ , TK_FYPP ) ends_operand = j > v % first . or . v % kinds ( j ) /= TK_INT ! not a statement label case ( TK_DOTOP ) ends_operand = v % is ( j , '.true.' ) . or . v % is ( j , '.false.' ) . or . index ( v % word ( j ), '._' ) > 0 case ( TK_OP ) ends_operand = v % is ( j , ')' ) . or . v % is ( j , ']' ) end select end function ends_operand logical function starts_operand ( j ) !! True if code token `j` can start an operand: a name, literal, inline fypp, dot operator, !! `(`, `[` or a sign. integer , intent ( in ) :: j !! index into `code(:)` starts_operand = . false . select case ( v % kind_of ( j )) case ( TK_NAME , TK_INT , TK_REAL , TK_STRING , TK_BOZ , TK_FYPP , TK_DOTOP ) starts_operand = . true . case ( TK_OP ) starts_operand = v % is ( j , '(' ) . or . v % is ( j , '[' ) . or . v % is ( j , '+' ) . or . v % is ( j , '-' ) end select end function starts_operand logical function type_star ( j ) !! True for the `*` of a length or kind selector: `real*8`, `character*(*)`, `character*10`. integer , intent ( in ) :: j !! index into `code(:)` select case ( v % word ( j - 1 )) case ( 'real' , 'integer' , 'complex' , 'logical' , 'character' , 'precision' ) type_star = . true . case default type_star = . false . end select end function type_star logical function conditional_colon ( j ) !! True if the `:` at `j` belongs to a conditional expression: a `?` comes before it at the same !! bracket depth, inside the same brackets. integer , intent ( in ) :: j !! index into `v%code(:)` of a `:` integer :: k conditional_colon = . false . if ( v % depth ( j ) == 0 ) return do k = j - 1 , 1 , - 1 if ( v % depth ( k ) < v % depth ( j )) return ! the opening bracket if ( v % depth ( k ) == v % depth ( j ) . and . v % is ( k , '?' )) then conditional_colon = . true . return end if end do end function conditional_colon logical function is_control_paren ( j ) !! True if `(` at `j` follows a control keyword: `if (`, `else if (`, `do while (`, !! `select case (`, `where (`, `forall (`, `case (`, `rank (`, `do concurrent (`. integer , intent ( in ) :: j !! index into `code(:)` is_control_paren = . false . if ( j < 2 ) return select case ( v % word ( j - 1 )) case ( 'if' , 'elseif' ) is_control_paren = j - 1 == v % first . or . v % is ( j - 2 , 'else' ) . or . v % is ( j - 2 , ':' ) case ( 'while' , 'concurrent' ) is_control_paren = v % is ( j - 2 , 'do' ) case ( 'case' , 'rank' ) is_control_paren = v % is ( j - 2 , 'select' ) . or . j - 1 == v % first case ( 'type' ) is_control_paren = v % is ( j - 2 , 'select' ) case ( 'selectcase' , 'selecttype' , 'selectrank' , 'where' , 'forall' ) is_control_paren = j - 1 == v % first . or . v % is ( j - 2 , ':' ) end select end function is_control_paren end subroutine statement_gaps","tags":"","url":"proc/statement_gaps.html"},{"title":"break_point – fformat","text":"private  function break_point(tokens, src, a, lend, start_col, line_length) result(best) The token after which to split tokens a:lend of a line that starts at token a in column start_col , or 0 if the code fits or cannot be split. Arguments Type Intent Optional Attributes Name type( token_list_t ), intent(in) :: tokens the tokens of src character(len=*), intent(in) :: src the source text integer, intent(in) :: a first token of the line integer, intent(in) :: lend last token of the line, its line break if it has one integer, intent(in) :: start_col column of token a integer, intent(in) :: line_length maximum line width, in characters Return Value integer Calls proc~~break_point~~CallsGraph proc~break_point break_point proc~priority priority proc~break_point->proc~priority proc~token_lower token_lower proc~break_point->proc~token_lower proc~token_text token_text proc~break_point->proc~token_text proc~utf8_width utf8_width proc~break_point->proc~utf8_width proc~make_lowercase make_lowercase proc~token_lower->proc~make_lowercase Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.