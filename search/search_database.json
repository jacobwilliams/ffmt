s to standard output logical :: check = . false . !! report files that would change; write nothing logical :: diff = . false . !! write a diff of the changes; write nothing else logical :: quiet = . false . !! do not report warnings logical :: help = . false . !! show the `--help` text and do nothing else logical :: version = . false . !! show the version and do nothing else end type cli_t type :: config_cache_t !! Configurations already found, by directory. type ( string_t ), allocatable :: dirs (:) !! absolute paths of the directories looked up type ( config_t ), allocatable :: configs (:) !! the configuration that applies in each of `dirs` end type config_cache_t contains function usage () result ( text ) !! The `--help` text. character ( len = :), allocatable :: text character , parameter :: nl = new_line ( 'a' ) text = 'Usage: fformat [OPTIONS] PATH...' // nl // & nl // & 'Format free-form Fortran source files in place. A directory is searched recursively for' // nl // & 'Fortran files; \"-\" reads standard input and writes standard output.' // nl // & nl // & 'Formatting:' // nl // & '  -i, --indent N              spaces per indentation level (default 4)' // nl // & '      --base-indent N         columns added to every line, program units included (default 0)' // nl // & '      --indent-units          indent the bodies of modules, submodules and programs' // nl // & '      --no-indent-procedures  do not indent the bodies of subroutines and functions' // nl // & '      --indent-fypp           indent the code inside fypp blocks (#:if, #:for, #:def, ...)' // nl // & '                              and the fypp directive lines with it' // nl // & '      --continuation STYLE    continuation lines: \"align\" with brackets and \"=\" (default),' // nl // & '                              or \"indent\" by a fixed amount' // nl // & '      --continuation-indent N extra indentation of continuation lines (default 4)' // nl // & '      --no-indent-comments    leave the indentation of comment lines unchanged' // nl // & '      --keep-column1-comments leave comment lines that start in column 1 there' // nl // & '      --comment-spacing N     blanks before a comment at the end of a line, unless it is' // nl // & '                              aligned with the comment on the line before or after' // nl // & '  -l, --line-length N         maximum line length (default 132, 0 for no limit): longer code' // nl // & '                              lines are split, and alignment uses less indentation' // nl // & '                              rather than exceed it' // nl // & '      --no-split              do not split long lines' // nl // & '      --sort-use              sort each group of use statements by module name' // nl // & '      --sort-use-only         sort the names in only: lists' // nl // & '      --relational STYLE      spelling of relational operators: \"symbols\" (.lt. becomes <),' // nl // & '                              \"letters\" (< becomes .lt.) or \"keep\" (default)' // nl // & '      --spaces RULE=MODE,...  blanks around operators; MODE is add (at least one blank),' // nl // & '                              remove or keep. RULE is one of assignment, keyword-args,' // nl // & '                              pointer, declarations, relational, logical, plus-minus,' // nl // & '                              mult-div, power, concat, comma, slice-colon, percent,' // nl // & '                              control-paren, conditional, defined-operators, or all' // nl // & '      --case WHAT=MODE,...    letter case; WHAT is keywords, operators, procedures' // nl // & '                              (intrinsic), constants (of iso_fortran_env and iso_c_binding),' // nl // & '                              types (kinds and exponents) or all, MODE is lower, upper or' // nl // & '                              keep (default keep)' // nl // & '      --set KEY=VALUE         any setting, as in a configuration file (e.g. spaces.comma=add)' // nl // & nl // & 'Files:' // nl // & '      --config FILE           read settings from FILE instead of searching for one' // nl // & '      --no-config             do not read configuration files' // nl // & '      --exclude PATTERN       skip matching files and directories in searched directories' // nl // & '                              (repeatable; hidden entries and \"build\" are skipped by default)' // nl // & '      --extensions LIST       extensions of the files to format in searched directories' // nl // & '                              (default f90,F90,f95,F95,f03,F03,f08,F08,f18,F18)' // nl // & nl // & 'Output:' // nl // & '  -s, --stdout                write the results to standard output' // nl // & '  -d, --diff                  write the changes as a unified diff; change no files' // nl // & '  -c, --check                 change no files; exit with status 1 if a file would change' // nl // & '  -q, --quiet                 do not report warnings' // nl // & '  -h, --help                  show this help' // nl // & '      --version               show the version' // nl // & nl // & 'Settings come from the defaults, then the nearest .fformat.toml (or an [extra.fformat]' // nl // & 'table in fpm.toml) in or above the file''s directory, then the command line.' // nl // & nl // & 'Formatter directives: a statement with a \"!&\" comment is left unchanged, and lines' // nl // & 'between \"!&<\" and \"!&>\" are left unchanged.' // nl // & nl // & 'Exit status: 0 on success, 1 if --check found files to format, 2 on errors.' end function usage subroutine parse_args ( args , cli , stat , errmsg ) !! Parse command-line arguments (without the program name). type ( string_t ), intent ( in ) :: args (:) !! the arguments, in order type ( cli_t ), intent ( out ) :: cli !! the parsed command line integer , intent ( out ) :: stat !! 0, or `EXIT_ERROR` for a bad command line character ( len = :), allocatable , intent ( out ) :: errmsg !! what is wrong, if `stat` is nonzero type ( format_options_t ) :: scratch integer :: k , j character ( len = :), allocatable :: arg logical :: only_paths stat = 0 allocate ( cli % settings ( 0 ), cli % paths ( 0 ), cli % exclude ( 0 )) cli % config = '' only_paths = . false . k = 0 do while ( k < size ( args )) k = k + 1 arg = args ( k )% s if ( only_paths . or . len ( arg ) == 0 . or . arg == '-' ) then cli % paths = [ cli % paths , string_t ( arg )] cycle end if if ( arg ( 1 : 1 ) /= '-' ) then cli % paths = [ cli % paths , string_t ( arg )] cycle end if select case ( arg ) case ( '--' ) only_paths = . true . case ( '-h' , '--help' ) cli % help = . true . case ( '--version' ) cli % version = . true . case ( '-s' , '--stdout' ) cli % stdout = . true . case ( '-c' , '--check' ) cli % check = . true . case ( '-d' , '--diff' ) cli % diff = . true . case ( '-q' , '--quiet' ) cli % quiet = . true . case ( '--no-config' ) cli % no_config = . true . case ( '--indent-units' ) call add ( 'indent-units' , 'true' ) case ( '--indent-fypp' ) call add ( 'indent-fypp' , 'true' ) case ( '--no-indent-procedures' ) call add ( 'indent-procedures' , 'false' ) case ( '--no-indent-comments' ) call add ( 'indent-comments' , 'false' ) case ( '--keep-column1-comments' ) call add ( 'column1-comments' , 'keep' ) case ( '--no-split' ) call add ( 'split' , 'false' ) case ( '--sort-use' ) call add ( 'sort-use' , 'true' ) case ( '--sort-use-only' ) call add ( 'sort-use-only' , 'true' ) case default if (. not . takes_value ( arg )) then call fail ( 'unknown option ' // arg ) return end if if ( k == size ( args )) then call fail ( 'missing value for ' // arg ) return end if k = k + 1 call option_value ( arg , args ( k )% s ) if ( stat /= 0 ) return end select end do ! check the settings now, so that a mistake is reported before any file is changed do j = 1 , size ( cli % settings ) call apply_setting ( scratch , cli % settings ( j )% key , cli % settings ( j )% value , stat , errmsg ) if ( stat /= 0 ) then stat = EXIT_ERROR return end if end do if (. not . ( cli % help . or . cli % version ) . and . size ( cli % paths ) == 0 ) call fail ( 'no files given' ) contains logical function takes_value ( opt ) !! True if option `opt` (as written, e.g. `-i` or `--indent`) is followed by a value. character ( len =* ), intent ( in ) :: opt !! the argument to test select case ( opt ) case ( '-i' , '--indent' , '--base-indent' , '--continuation' , '--continuation-indent' , '-l' , '--line-length' , '--relational' , & '--spaces' , '--case' , '--set' , '--config' , '--exclude' , '--extensions' , '--comment-spacing' ) takes_value = . true . case default takes_value = . false . end select end function takes_value subroutine option_value ( opt , value ) !! Record option `opt`, one for which `takes_value` is true, with `value`, the argument after it. character ( len =* ), intent ( in ) :: opt !! the option, as written character ( len =* ), intent ( in ) :: value !! its value select case ( opt ) case ( '-i' , '--indent' ) call add ( 'indent' , value ) case ( '--base-indent' ) call add ( 'base-indent' , value ) case ( '--continuation' ) call add ( 'continuation' , value ) case ( '--continuation-indent' ) call add ( 'continuation-indent' , value ) case ( '--comment-spacing' ) call add ( 'comment-spacing' , value ) case ( '-l' , '--line-length' ) call add ( 'line-length' , value ) case ( '--relational' ) call add ( 'relational' , value ) case ( '--spaces' ) call add_list ( 'spaces.' , value ) case ( '--case' ) call add_list ( 'case.' , value ) case ( '--set' ) call add_list ( '' , value ) case ( '--config' ) cli % config = value case ( '--exclude' ) cli % exclude = [ cli % exclude , string_t ( value )] case ( '--extensions' ) call extension_list ( value ) end select end subroutine option_value subroutine add ( key , value ) !! Append the setting `key` with `value` to `cli%settings`. character ( len =* ), intent ( in ) :: key !! setting name, as in a configuration file character ( len =* ), intent ( in ) :: value !! its value as text cli % settings = [ cli % settings , setting_t ( key , value )] end subroutine add subroutine add_list ( prefix , text ) !! Comma-separated `NAME=VALUE` items. character ( len =* ), intent ( in ) :: prefix !! prepended to each `NAME` to make the setting name, e.g. `spaces.` character ( len =* ), intent ( in ) :: text !! the items integer :: i , j , eq character ( len = :), allocatable :: item i = 1 do while ( i <= len ( text )) j = index ( text ( i :), ',' ) if ( j == 0 ) then j = len ( text ) + 1 else j = i + j - 1 end if item = text ( i : j - 1 ) eq = index ( item , '=' ) if ( eq == 0 ) then call fail ( 'expected NAME=VALUE for ' // arg // ', not \"' // item // '\"' ) return end if call add ( prefix // item ( 1 : eq - 1 ), item ( eq + 1 :)) i = j + 1 end do end subroutine add_list subroutine extension_list ( text ) !! Set `cli%extensions` from the comma-separated list `text`, dropping a leading `.` of each !! extension and skipping empty items. character ( len =* ), intent ( in ) :: text !! the value of `--extensions` integer :: i , j allocate ( cli % extensions ( 0 )) i = 1 do while ( i <= len ( text )) j = index ( text ( i :), ',' ) if ( j == 0 ) then j = len ( text ) + 1 else j = i + j - 1 end if if ( j > i ) then if ( text ( i : i ) == '.' ) then cli % extensions = [ cli % extensions , string_t ( text ( i + 1 : j - 1 ))] else cli % extensions = [ cli % extensions , string_t ( text ( i : j - 1 ))] end if end if i = j + 1 end do end subroutine extension_list subroutine fail ( msg ) !! Make parsing fail with `EXIT_ERROR` and message `msg`. character ( len =* ), intent ( in ) :: msg !! what is wrong stat = EXIT_ERROR errmsg = msg end subroutine fail end subroutine parse_args integer function run ( cli ) result ( status ) !! Format the paths of `cli` and return the exit status. type ( cli_t ), intent ( in ) :: cli !! the parsed command line type ( config_cache_t ) :: cache type ( string_t ), allocatable :: files (:) integer :: k , j if ( cli % help ) then write ( output_unit , '(a)' ) usage () status = EXIT_OK return end if if ( cli % version ) then write ( output_unit , '(a)' ) 'fformat ' // VERSION status = EXIT_OK return end if allocate ( cache % dirs ( 0 ), cache % configs ( 0 )) status = EXIT_OK do k = 1 , size ( cli % paths ) associate ( path => cli % paths ( k )% s ) if ( path == '-' ) then status = max ( status , process_stdin ( cli , cache )) else if ( is_directory ( path )) then call directory_files ( cli , cache , path , files , status ) do j = 1 , size ( files ) status = max ( status , process_file ( cli , cache , files ( j )% s )) end do else status = max ( status , process_file ( cli , cache , path )) end if end associate end do end function run subroutine directory_files ( cli , cache , dir , files , status ) !! The Fortran files under `dir`, selected with the `[files]` settings of its configuration and !! the command line. type ( cli_t ), intent ( in ) :: cli !! the parsed command line type ( config_cache_t ), intent ( inout ) :: cache !! configurations found so far character ( len =* ), intent ( in ) :: dir !! the directory, as given on the command line type ( string_t ), allocatable , intent ( out ) :: files (:) !! paths of the files found integer , intent ( inout ) :: status !! exit status so far; set to `EXIT_ERROR` if the !! configuration cannot be read type ( config_t ) :: cfg type ( string_t ), allocatable :: extensions (:), exclude (:) integer :: stat character ( len = :), allocatable :: errmsg extensions = default_extensions () exclude = default_exclude () call config_for ( cli , cache , absolute_path ( dir ), cfg , stat , errmsg ) if ( stat /= 0 ) then write ( error_unit , '(a)' ) 'error: ' // errmsg status = EXIT_ERROR allocate ( files ( 0 )) return end if if ( allocated ( cfg % extensions )) extensions = cfg % extensions if ( allocated ( cfg % exclude )) exclude = cfg % exclude if ( allocated ( cli % extensions )) extensions = cli % extensions exclude = [ exclude , cli % exclude ] call collect_files ( dir , extensions , exclude , files ) end subroutine directory_files subroutine config_for ( cli , cache , dir , cfg , stat , errmsg ) !! The configuration that applies in directory `dir` (absolute). type ( cli_t ), intent ( in ) :: cli !! the parsed command line (`--config`, `--no-config`) type ( config_cache_t ), intent ( inout ) :: cache !! configurations found so far; `cfg` is added character ( len =* ), intent ( in ) :: dir !! absolute path of the directory type ( config_t ), intent ( out ) :: cfg !! the configuration; `cfg%path` is `''` if there is none integer , intent ( out ) :: stat !! nonzero if a configuration file cannot be read character ( len = :), allocatable , intent ( out ) :: errmsg !! what is wrong, if `stat` is nonzero logical :: found integer :: k stat = 0 if ( cli % no_config ) then cfg % path = '' allocate ( cfg % settings ( 0 )) return end if if ( len ( cli % config ) > 0 ) then call load_config ( cli % config , ends_with ( cli % config , 'fpm.toml' ), cfg , found , stat , errmsg ) if ( stat == 0 . and . . not . found ) then stat = 1 errmsg = cli % config // ': no [extra.fformat] table' end if return end if do k = 1 , size ( cache % dirs ) if ( cache % dirs ( k )% s == dir . and . len ( cache % dirs ( k )% s ) == len ( dir )) then cfg = cache % configs ( k ) return end if end do call find_config ( dir , cfg , stat , errmsg ) if ( stat /= 0 ) return cache % dirs = [ cache % dirs , string_t ( dir )] cache % configs = [ cache % configs , cfg ] end subroutine config_for subroutine options_for ( cli , cache , dir , opts , stat , errmsg ) !! The options for a file in directory `dir`: defaults, then configuration, then command line. type ( cli_t ), intent ( in ) :: cli !! the parsed command line type ( config_cache_t ), intent ( inout ) :: cache !! configurations found so far character ( len =* ), intent ( in ) :: dir !! the file's directory, relative or absolute type ( format_options_t ), intent ( out ) :: opts !! the options integer , intent ( out ) :: stat !! nonzero for an unreadable configuration or a bad setting character ( len = :), allocatable , intent ( out ) :: errmsg !! what is wrong, if `stat` is nonzero type ( config_t ) :: cfg integer :: k call config_for ( cli , cache , absolute_path ( dir ), cfg , stat , errmsg ) if ( stat /= 0 ) return do k = 1 , size ( cfg % settings ) call apply_setting ( opts , cfg % settings ( k )% key , cfg % settings ( k )% value , stat , errmsg ) if ( stat /= 0 ) then errmsg = cfg % path // ': ' // errmsg return end if end do do k = 1 , size ( cli % settings ) call apply_setting ( opts , cli % settings ( k )% key , cli % settings ( k )% value , stat , errmsg ) if ( stat /= 0 ) return end do end subroutine options_for integer function process_stdin ( cli , cache ) result ( status ) !! Format standard input to standard output (or report it with `--check` / `--diff`), with !! the configuration of the current directory, and return the exit status. type ( cli_t ), intent ( in ) :: cli !! the parsed command line type ( config_cache_t ), intent ( inout ) :: cache !! configurations found so far character ( len = :), allocatable :: text call read_stdin ( text ) status = process_text ( cli , cache , '<stdin>' , '.' , text , . true .) end function process_stdin integer function process_file ( cli , cache , path ) result ( status ) !! Format file `path` in place (or write it to standard output, or report it with `--check` / !! `--diff`), with the configuration of its directory, and return the exit status. type ( cli_t ), intent ( in ) :: cli !! the parsed command line type ( config_cache_t ), intent ( inout ) :: cache !! configurations found so far character ( len =* ), intent ( in ) :: path !! the file, as given on the command line or found in a directory character ( len = :), allocatable :: text , errmsg , dir integer :: stat call read_file ( path , text , stat , errmsg ) if ( stat /= 0 ) then write ( error_unit , '(a)' ) path // ': error: ' // errmsg status = EXIT_ERROR return end if dir = parent_directory ( absolute_path ( path )) status = process_text ( cli , cache , path , dir , text , cli % stdout ) end function process_file integer function process_text ( cli , cache , name , dir , text , to_stdout ) result ( status ) !! Format `text` from file `name` in directory `dir`, and write or report the result. type ( cli_t ), intent ( in ) :: cli !! the parsed command line type ( config_cache_t ), intent ( inout ) :: cache !! configurations found so far character ( len =* ), intent ( in ) :: name !! the file, for messages and diff headers and to write !! the result to; `<stdin>` for standard input character ( len =* ), intent ( in ) :: dir !! the directory whose configuration applies character ( len =* ), intent ( in ) :: text !! the source as read logical , intent ( in ) :: to_stdout !! write the result to standard output instead of to `name` type ( format_options_t ) :: opts character ( len = :), allocatable :: out , errmsg type ( diagnostic_t ), allocatable :: diags (:) integer :: stat , d logical :: changed status = EXIT_OK call options_for ( cli , cache , dir , opts , stat , errmsg ) if ( stat /= 0 ) then write ( error_unit , '(a)' ) name // ': error: ' // errmsg status = EXIT_ERROR return end if call format_text ( text , opts , out , stat , errmsg , diags ) if (. not . cli % quiet ) then do d = 1 , size ( diags ) write ( error_unit , '(a)' ) name // ':' // to_s ( diags ( d )% line ) // ': warning: ' // diags ( d )% message end do end if if ( stat /= FMT_OK ) then write ( error_unit , '(a)' ) name // ': error: ' // errmsg status = EXIT_ERROR return end if changed = out /= text . or . len ( out ) /= len ( text ) if ( cli % diff . and . changed ) write ( output_unit , '(a)' , advance = 'no' ) unified_diff ( text , out , name ) if ( cli % check ) then if ( changed ) then if (. not . cli % diff ) write ( output_unit , '(a)' ) name // ': would be reformatted' status = EXIT_CHANGED end if else if ( cli % diff ) then continue else if ( to_stdout ) then write ( output_unit , '(a)' , advance = 'no' ) out else if ( changed ) then call write_file ( name , out , stat , errmsg ) if ( stat /= 0 ) then write ( error_unit , '(a)' ) name // ': error: ' // errmsg status = EXIT_ERROR end if end if end function process_text pure logical function ends_with ( s , suffix ) !! True if string `s` ends with `suffix`. character ( len =* ), intent ( in ) :: s , suffix !! the string, and the ending to look for ends_with = . false . if ( len ( s ) >= len ( suffix )) ends_with = s ( len ( s ) - len ( suffix ) + 1 :) == suffix end function ends_with end module ffmt_cli","tags":"","url":"sourcefile/ffmt_cli.f90.html"},{"title":"ffmt_directives.f90 – fformat","text":"This file depends on sourcefile~~ffmt_directives.f90~~EfferentGraph sourcefile~ffmt_directives.f90 ffmt_directives.f90 sourcefile~ffmt_statements.f90 ffmt_statements.f90 sourcefile~ffmt_directives.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_tokens.f90 ffmt_tokens.f90 sourcefile~ffmt_directives.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_statements.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_strings.f90 ffmt_strings.f90 sourcefile~ffmt_statements.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_tokens.f90->sourcefile~ffmt_strings.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~ffmt_directives.f90~~AfferentGraph sourcefile~ffmt_directives.f90 ffmt_directives.f90 sourcefile~ffmt_source.f90 ffmt_source.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_directives.f90 sourcefile~ffmt_case.f90 ffmt_case.f90 sourcefile~ffmt_case.f90->sourcefile~ffmt_source.f90 sourcefile~ffmt_format.f90 ffmt_format.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_source.f90 sourc