, tokens , j , j , [ col , default , in_col ], always_original = . true .) w % comment_in = in_col w % comment_out = col end function comment_column","tags":"","url":"proc/comment_column.html"},{"title":"continuation_target – fformat","text":"private pure function continuation_target(w, ind, opts) result(target) Column for the code of a continuation line: the first item after the innermost open\nbracket; outside brackets, the first item after an assignment, a use statement's only: or a declaration's :: ; otherwise a fixed indent. Arguments Type Intent Optional Attributes Name type( writer_t ), intent(in) :: w the output and the alignment state integer, intent(in) :: ind indentation of the statement, in blanks type( format_options_t ), intent(in) :: opts the formatting options Return Value integer Called by proc~~continuation_target~~CalledByGraph proc~continuation_target continuation_target proc~emit_statement emit_statement proc~emit_statement->proc~continuation_target proc~layout layout proc~layout->proc~emit_statement proc~format_pass format_pass proc~format_pass->proc~layout proc~format_text format_text proc~format_text->proc~format_pass proc~relayout relayout proc~format_text->proc~relayout proc~relayout->proc~format_pass proc~process_text process_text proc~process_text->proc~format_text proc~process_file process_file proc~process_file->proc~process_text proc~process_stdin process_stdin proc~process_stdin->proc~process_text proc~run run proc~run->proc~process_file proc~run->proc~process_stdin Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure integer function continuation_target ( w , ind , opts ) result ( target ) !! Column for the code of a continuation line: the first item after the innermost open !! bracket; outside brackets, the first item after an assignment, a `use` statement's `only:` !! or a declaration's `::`; otherwise a fixed indent. type ( writer_t ), intent ( in ) :: w !! the output and the alignment state integer , intent ( in ) :: ind !! indentation of the statement, in blanks type ( format_options_t ), intent ( in ) :: opts !! the formatting options integer :: a target = ind + opts % continuation_indent if ( opts % continuation /= CONT_ALIGN ) return if ( w % nbrackets > 0 ) then if ( w % bracket_first ( w % nbrackets ) >= 0 ) target = w % bracket_first ( w % nbrackets ) return end if do a = 1 , size ( w % anchor_col ) if ( w % anchor_col ( a ) >= 0 ) then target = w % anchor_col ( a ) return end if end do end function continuation_target","tags":"","url":"proc/continuation_target.html"},{"title":"first_non_blank – fformat","text":"private pure function first_non_blank(tokens, first, last) result(f) First token in first:last that is not a blank, or last + 1 . Arguments Type Intent Optional Attributes Name type( token_list_t ), intent(in) :: tokens the token list integer, intent(in) :: first the token range to search integer, intent(in) :: last the token range to search Return Value integer Called by proc~~first_non_blank~~CalledByGraph proc~first_non_blank first_non_blank proc~emit_continuation emit_continuation proc~emit_continuation->proc~first_non_blank proc~emit_fypp_line emit_fypp_line proc~emit_fypp_line->proc~first_non_blank proc~emit_statement emit_statement proc~emit_statement->proc~first_non_blank proc~emit_statement->proc~emit_continuation proc~layout layout proc~layout->proc~emit_fypp_line proc~layout->proc~emit_statement proc~format_pass format_pass proc~format_pass->proc~l