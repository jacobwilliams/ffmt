tput_unit , '(a)' ) 'fformat ' // VERSION status = EXIT_OK return end if allocate ( cache % dirs ( 0 ), cache % configs ( 0 )) status = EXIT_OK do k = 1 , size ( cli % paths ) associate ( path => cli % paths ( k )% s ) if ( path == '-' ) then status = max ( status , process_stdin ( cli , cache )) else if ( is_directory ( path )) then call directory_files ( cli , cache , path , files , status ) do j = 1 , size ( files ) status = max ( status , process_file ( cli , cache , files ( j )% s )) end do else status = max ( status , process_file ( cli , cache , path )) end if end associate end do end function run","tags":"","url":"proc/run.html"},{"title":"usage – fformat","text":"public  function usage() result(text) The --help text. Arguments None Return Value character(len=:), allocatable Called by proc~~usage~~CalledByGraph proc~usage usage proc~run run proc~run->proc~usage Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function usage () result ( text ) !! The `--help` text. character ( len = :), allocatable :: text character , parameter :: nl = new_line ( 'a' ) text = 'Usage: fformat [OPTIONS] PATH...' // nl // & nl // & 'Format free-form Fortran source files in place. A directory is searched recursively for' // nl // & 'Fortran files; \"-\" reads standard input and writes standard output.' // nl // & nl // & 'Formatting:' // nl // & '  -i, --indent N              spaces per indentation level (default 4)' // nl // & '      --base-indent N         columns added to every line, program units included (default 0)' // nl // & '      --indent-units          indent the bodies of modules, submodules and programs' // nl // & '      --no-indent-procedures  do not indent the bodies of subroutines and functions' // nl // & '      --indent-fypp           indent the code inside fypp blocks (#:if, #:for, #:def, ...)' // nl // & '                              and the fypp directive lines with it' // nl // & '      --continuation STYLE    continuation lines: \"align\" with brackets and \"=\" (default),' // nl // & '                              or \"indent\" by a fixed amount' // nl // & '      --continuation-indent N extra indentation of continuation lines (default 4)' // nl // & '      --no-indent-comments    leave the indentation of comment lines unchanged' // nl // & '      --keep-column1-comments leave comment lines that start in column 1 there' // nl // & '      --comment-spacing N     blanks before a comment at the end of a line, unless it is' // nl // & '                              aligned with the comment on the line before or after' // nl // & '  -l, --line-length N         maximum line length (default 132, 0 for no limit): longer code' // nl // & '                              lines are split, and alignment uses less indentation' // nl // & '                              rather than exceed it' // nl // & '      --no-split              do not split long lines' // nl // & '      --sort-use              sort each group of use statements by module name' // nl // & '      --sort-use-only         sort the names in only: lists' // nl // & '      --relational STYLE      spelling of relational operators: \"symbols\" (.lt. becomes <),' // nl // & '                              \"letters\" (< becomes .lt.) or \"keep\" (default)' // nl // & '      --spaces RULE=MODE,...  blanks around operators; MODE is add (at least one blank),' // nl // & '                              remove or keep. RULE is one of assignment, keyword-args,' // nl // & '                              pointer, declarations, relational, logical, plus-minus,' // nl // & '                              mult-div, power, concat, comma, slice-colon, percent,' // nl // & '                              control-paren, conditional, defined-operators, or all' // nl // & '      --case WHAT=MODE,...    letter case; WHAT is keywords, operators, procedures' // nl // & '                              (intrinsic), constants (of iso_fortran_env and iso_c_binding),' // nl // & '                              types (kinds and exponents) or all, MODE is lower, upper or' // nl // & '                              keep (default keep)' // nl // & '      --set KEY=VALUE         any setting, as in a configuration file (e.g. spaces.comma=add)' // nl // & nl // & 'Files:' // nl // & '      --config FILE           read settings from FILE instead of searching for one' // nl // & '      --no-config             do not read configuration files' // nl // & '      --exclude PATTERN       skip matching files and directories in searched directories' // nl // & '                              (repeatable; hidden entries and \"build\" are skipped by default)' // nl // & '      --extensions LIST       extensions of the files to format in searched directories' // nl // & '                              (default f90,F90,f95,F95,f03,F03,f08,F08,f18,F18)' // nl // & nl // & 'Output:' // nl // & '  -s, --stdout                write the results to standard output' // nl // & '  -d, --diff                  write the changes as a unified diff; change no files' // nl // & '  -c, --check                 change no files; exit with status 1 if a file would change' // nl // & '  -q, --quiet                 do not report warnings' // nl // & '  -h, --help                  show this help' // nl // & '      --version               show the version' // nl // & nl // & 'Settings come from the defaults, then the nearest .fformat.toml (or an [extra.fformat]' // nl // & 'table in fpm.toml) in or above the file''s directory, then the command line.' // nl // & nl // & 'Formatter directives: a statement with a \"!&\" comment is left unchanged, and lines' // nl // & 'between \"!&<\" and \"!&>\" are left unchanged.' // nl // & nl // & 'Exit status: 0 on success, 1 if --check found files to format, 2 on errors.' end function usage","tags":"","url":"proc/usage.html"},{"title":"config_for – fformat","text":"private  subroutine config_for(cli, cache, dir, cfg, stat, errmsg) The configuration that applies in directory dir (absolute). Arguments Type Intent Optional Attributes Name type( cli_t ), intent(in) :: cli the parsed command line ( --config , --no-config ) type( config_cache_t ), intent(inout) :: cache configurations found so far; cfg is added character(len=*), intent(in) :: dir absolute path of the directory type( config_t ), intent(out) :: cfg the configuration; cfg%path is '' if there is none integer, intent(out) :: stat nonzero if a configuration file cannot be read character(len=:), intent(out), allocatable :: errmsg what is wrong, if stat is nonzero Calls proc~~config_for~~CallsGraph proc~config_for config_for proc~ends_with ends_with proc~config_for->proc~ends_with proc~find_config find_config proc~config_for->proc~find_config proc~load_config load_config proc~config_for->proc~load_config proc~find_config->proc~load_config proc~empty empty proc~find_config->proc~empty proc~join_path join_path proc~find_config->proc~join_path proc~parent_directory parent_directory proc~find_config->proc~parent_directory get get proc~load_config->get get_keys get_keys proc~load_config->get_keys get_type get_type proc~load_config->get_type get_value get_value proc~load_config->get_value proc~load_config->proc~empty proc~to_s to_s proc~load_config->proc~to_s toml_load toml_load proc~load_config->toml_load Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type 