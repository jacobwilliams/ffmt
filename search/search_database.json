 ) then k = k - 1 buf ( k : k ) = '-' end if s = buf ( k :) end function to_s elemental character function lower_char ( c ) !! `c` in lowercase (ASCII letters only; other bytes, including UTF-8, are unchanged). character , intent ( in ) :: c !! the character if ( c >= 'A' . and . c <= 'Z' ) then lower_char = achar ( iachar ( c ) + 32 ) else lower_char = c end if end function lower_char pure function lowercase ( s ) result ( l ) !! `s` in lowercase (see [[lower_char]]). character ( len =* ), intent ( in ) :: s !! the text character ( len = len ( s )) :: l integer :: k do k = 1 , len ( s ) l ( k : k ) = lower_char ( s ( k : k )) end do end function lowercase pure subroutine make_lowercase ( s ) !! Turn `s` into lowercase in place, without a temporary copy (see [[lower_char]]). character ( len =* ), intent ( inout ) :: s !! the text integer :: k do k = 1 , len ( s ) if ( s ( k : k ) >= 'A' . and . s ( k : k ) <= 'Z' ) s ( k : k ) = achar ( iachar ( s ( k : k )) + 32 ) end do end subroutine make_lowercase pure subroutine builder_append ( self , str ) !! Append `str` to the string, doubling the storage when it is full. class ( string_builder_t ), intent ( inout ) :: self !! the builder character ( len =* ), intent ( in ) :: str !! the piece to append character ( len = :), allocatable :: tmp if ( len ( str ) == 0 ) return if (. not . allocated ( self % buf )) allocate ( character ( len = max ( 256 , len ( str ))) :: self % buf ) if ( self % n + len ( str ) > len ( self % buf )) then allocate ( character ( len = max ( 2 * len ( self % buf ), self % n + len ( str ))) :: tmp ) tmp ( 1 : self % n ) = self % buf ( 1 : self % n ) call move_alloc ( tmp , self % buf ) end if self % buf ( self % n + 1 : self % n + len ( str )) = str self % n = self % n + len ( str ) end subroutine builder_append pure function builder_get ( self ) result ( str ) !! The string built so far. class ( string_builder_t ), intent ( in ) :: self !! the builder character ( len = :), allocatable :: str if ( allocated ( self % buf )) then str = self % buf ( 1 : self % n ) else str = '' end if end function builder_get pure integer function builder_length ( self ) result ( n ) !! Length of the string built so far. class ( string_builder_t ), intent ( in ) :: self !! the builder n = self % n end function builder_length end module ffmt_strings","tags":"","url":"sourcefile/ffmt_strings.f90.html"},{"title":"ffmt_cli.f90 – fformat","text":"This file depends on sourcefile~~ffmt_cli.f90~~EfferentGraph sourcefile~ffmt_cli.f90 ffmt_cli.f90 sourcefile~ffmt_config.f90 ffmt_config.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_config.f90 sourcefile~ffmt_diff.f90 ffmt_diff.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_diff.f90 sourcefile~ffmt_format.f90 ffmt_format.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_format.f90 sourcefile~ffmt_fs.f90 ffmt_fs.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_fs.f90 sourcefile~ffmt_io.f90 ffmt_io.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_io.f90 sourcefile~ffmt_options.f90 ffmt_options.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_options.f90 sourcefile~ffmt_settings.f90 ffmt_settings.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_settings.f90 sourcefile~ffmt_strings.f90 ffmt_strings.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_walk.f90 ffmt_walk.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_walk.f90 sourcefile~ffmt_config.f90->sourcefile~ffmt_fs.f90 sourcefile~ffmt_config.f90->sourcefile~ffmt_settings.f90 sourcefile~ffmt_config.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_diff.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_options.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_case.f90 ffmt_case.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_case.f90 sourcefile~ffmt_layout.f90 ffmt_layout.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_layout.f90 sourcefile~ffmt_lexer.f90 ffmt_lexer.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_lexer.f90 sourcefile~ffmt_linebr