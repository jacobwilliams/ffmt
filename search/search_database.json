ytes of file `path`. character ( len =* ), intent ( in ) :: path !! the file to read character ( len = :), allocatable , intent ( out ) :: text !! the contents; `''` if the file cannot be opened integer , intent ( out ) :: stat !! `iostat` of the open or read: nonzero on failure character ( len = :), allocatable , intent ( out ) :: errmsg !! the system's message, if `stat` is nonzero integer :: unit , nbytes character ( len = 256 ) :: msg text = '' open ( newunit = unit , file = path , access = 'stream' , form = 'unformatted' , status = 'old' , & action = 'read' , iostat = stat , iomsg = msg ) if ( stat /= 0 ) then errmsg = trim ( msg ) return end if inquire ( unit = unit , size = nbytes ) if ( nbytes > 0 ) then deallocate ( text ) allocate ( character ( len = nbytes ) :: text ) read ( unit , iostat = stat , iomsg = msg ) text if ( stat /= 0 ) errmsg = trim ( msg ) end if close ( unit ) end subroutine read_file subroutine write_file ( path , text , stat , errmsg ) !! Replace the contents of file `path` (created if needed) with the bytes of `text`. character ( len =* ), intent ( in ) :: path !! the file to write character ( len =* ), intent ( in ) :: text !! the new contents integer , intent ( out ) :: stat !! `iostat` of the open or write: nonzero on failure character ( len = :), allocatable , intent ( out ) :: errmsg !! the system's message, if `stat` is nonzero integer :: unit character ( len = 256 ) :: msg open ( newunit = unit , file = path , access = 'stream' , form = 'unformatted' , status = 'replace' , & action = 'write' , iostat = stat , iomsg = msg ) if ( stat /= 0 ) then errmsg = trim ( msg ) return end if write ( unit , iostat = stat , iomsg = msg ) text if ( stat /= 0 ) errmsg = trim ( msg ) close ( unit ) end subroutine write_file subroutine read_stdin ( text ) !! All of standard input. Lines are read as text, so each line ends with a line feed, except a !! last line without one; carriage returns of CRLF line endings are kept as part of the line. use , intrinsic :: iso_fortran_env , only : input_unit use ffmt_strings , only : string_builder_t character ( len = :), allocatable , intent ( out ) :: text !! the input type ( string_builder_t ) :: buf character ( len = 4096 ) :: chunk integer :: ios , n do read ( input_unit , '(a)' , advance = 'no' , iostat = ios , size = n ) chunk call buf % append ( chunk ( 1 : n )) if ( is_iostat_eor ( ios )) then call buf % append ( achar ( 10 )) else if ( ios /= 0 ) then exit ! end of input end if end do text = buf % get () end subroutine read_stdin end module ffmt_io","tags":"","url":"sourcefile/ffmt_io.f90.html"},{"title":"ffmt_case.f90 – fformat","text":"This file depends on sourcefile~~ffmt_case.f90~~EfferentGraph sourcefile~ffmt_case.f90 ffmt_case.f90 sourcefile~ffmt_options.f90 ffmt_options.f90 sourcefile~ffmt_case.f90->sourcefile~ffmt_options.f90 sourcefile~ffmt_source.f90 ffmt_source.f90 sourcefile~ffmt_case.f90->sourcefile~ffmt_source.f90 sourcefile~ffmt_statements.f90 ffmt_statements.f90 sourcefile~ffmt_case.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_tokens.f90 ffmt_tokens.f90 sourcefile~ffmt_case.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_directives.f90 ffmt_directives.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_directives.f90 sourcefile~ffmt_lexer.f90 ffmt_lexer.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_lexer.f90 sourcefile~ffmt_statements.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_strings.f90 ffmt_strings.f90 sourcefile~ffmt_statements.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_tokens.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_directives.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_directives.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_lexer.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_lexer.f90->sourcefile~ffmt_strings.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Files dependent on this one sourcefile~~ffmt_case.f90~~AfferentGraph sourcefile~ffmt_case.f90 ffmt_case.f90 sourcefile~ffmt_format.f90 ffmt_format.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_case.f90 sourcefile~ffmt_layout.f90 ffmt_layout.f90 sourcefile~ffmt_format.f90->sourcefile~ffmt_layout.f90 sourcefile~ffmt_layout.f90->sourcefile~ffmt_case.f90 sourcefile~ffmt_cli.f90 ffmt_cli.f90 sourcefile~ffmt_cli.f90->sourcefile~ffmt_format.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Source Code module ffmt_case !! Letter case of keywords, dot operators, intrinsic procedures, the constants of the intrinsic !! modules, and kinds. !! !! Fortran names are not reserved, so a word is only treated as a keyword where its position makes it !! one: the leading words of a statement (`end subroutine`, `integer`, `if`, `else if`, `select case`, !! `implicit none`, ...), the attributes of a declaration before `::`, `in`/`out`/`inout` in `intent()`, !! `kind=`/`len=` in a type, `then`, `only:`, `result()` and `bind()`. A word that names something !! (`call open(...)`, `subroutine real`, `end function do`) keeps its case. Changing the case of a name !! never changes the meaning of the code, so a misclassified word is a matter of style only. !! !! Intrinsic procedures are recognized where they are called (followed by `(`, or after `call`), and the !! constants and types of `iso_fortran_env` and `iso_c_binding` wherever they are used, but not as the !! first word of a statement, after `%`, as an entity being declared, or as the name of a procedure !! being defined. Kinds are the values of `kind=`, the kind of a declaration's type (`real(dp) :: x`), !! the kind of a literal (`2_int64`, `.true._lk`, `ck_'a'`) and exponent letters (`1.0e-3`). use ffmt_tokens use ffmt_statements use ffmt_options , only : case_options_t , CASE_KEEP use ffmt_source , only : source_t implicit none private public :: compute_case , kind_part type , public :: case_marks_t !! The letter case wanted for each token (`CASE_KEEP`, `CASE_LOWER` or `CASE_UPPER`). integer , allocatable :: whole (:) !! for the whole text of each token integer , allocatable :: part (:) !! for the kind part of a token only (see [[kind_part]]), applied !! after `whole` end type case_marks_t ! words that are keywords at the start of a statement (or of a declaration attribute) character ( len =* ), parameter :: KEYWORDS ( * ) = [ character ( len = 16 ) :: & 'abstract' , 'allocatable' , 'allocate' , 'assign' , 'associate' , & 'asynchronous' , 'backspace' , 'bind' , 'block' , 'call' , 'case' , & 'change' , 'character' , 'class' , 'close' , 'codimension' , & 'common' , 'complex' , 'concurrent' , 'contains' , 'contiguous' , & 'continue' , 'critical' , 'cycle' , 'data' , 'deallocate' , & 'default' , 'deferred' , 'dimension' , 'do' , 'double' , & 'doubleprecision' , 'elemental' , 'else' , 'elseif' , 'elsewhere' , & 'end' , 'endfile' , 'entry' , 'enum' , 'enumerator' , & 'enumeration' , 'equivalence' , 'error' , 'exit' , 'extends' , 'external' , & 'final' , 'flush' , 'forall' , 'function' , 'generic' , 'go' , & 'goto' , 'if' , 'implicit' , 'import' , 'impure' , 'include' , & 'inquire' , 'integer' , 'intent' , 'interface' , 'intrinsic' , & 'is' , 'logical' , 'module' , 'namelist' , 'non_intrinsic' , & 'non_overridable' , 'non_recursive' , 'none' , 'nopass' , & 'nullify' , 'open' , 'optional' , 'parameter' , 'pass' , 'pause' , & 'pointer' , 'precision' , 'print' , 'private' , 'procedure' , & 'program' , 'protected' , 'public' , 'pure' , 'rank' , 'read' , & 'real' , 'recursive' , 'return' , 'rewind' , 'save' , 'select' , & 'selectcase' , 'selectrank' , 'selecttype' , 'sequence' , & 'simple' , 'stop' , 'submodule' , 'subroutine' , 'sync' , 'target' , & 'team' , 'then' , 'type' , 'use' , 'value' , 'volatile' , 'wait' , & 'where' , 'while' , 'write' ] ! keywords followed by a name: the leading words of a statement end after them character ( len =* ), parameter :: INTRODUCERS ( * ) = [ character ( len = 12 ) :: & 'call' , 'subroutine' , 'function' , 'program' , 'module' , 'submodule' , 'use' , & 'entry' , & 'procedure' , 'interface' , 'go' , 'goto' , 'cycle' , 'exit' , 'data' , 'common' , & 'namelist' , 'is' ] ! intrinsic procedures (F2023 table 16.1), specific names, and the procedures of the intrinsic modules character ( len =* ), parameter :: INTRINSIC_PROCEDURES ( * ) = [ character ( len = 24 ) :: & 'abs' , 'achar' , 'acos' , 'acosd' , 'acosh' , 'acospi' , 'adjustl' , & 'adjustr' , 'aimag' , & 'aint' , 'all' , 'allocated' , 'alog' , 'alog10' , 'amax0' , 'amax1' , 'amin0' , & 'amin1' , 'amod' , & 'anint' , 'any' , 'asin' , 'asind' , 'asinh' , 'asinpi' , 'associated' , & 'atan' , 'atan2' , & 'atan2d' , 'atan2pi' , 'atand' , 'atanh' , 'atanpi' , 'atomic_add' , & 'atomic_and' , & 'atomic_cas' , 'atomic_define' , 'atomic_fetch_add' , 'atomic_fetch_and' , & 'atomic_fetch_or' , & 'atomic_fetch_xor' , 'atomic_or' , 'atomic_ref' , 'atomic_xor' , & 'bessel_j0' , 'bessel_j1' , & 'bessel_jn' , 'bessel_y0' , 'bessel_y1' , 'bessel_yn' , 'bge' , 'bgt' , & 'bit_size' , 'ble' , & 'blt' , 'btest' , 'c_associated' , 'c_f_pointer' , 'c_f_procpointer' , & 'c_f_strpointer' , & 'c_funloc' , 'c_loc' , 'c_sizeof' , 'cabs' , 'ccos' , 'ceiling' , 'cexp' , & 'char' , 'clog' , & 'cmplx' , 'co_broadcast' , 'co_max' , 'co_min' , 'co_reduce' , 'co_sum' , & 'command_argument_count' , 'compiler_options' , 'compiler_version' , & 'conjg' , 'cos' , 'cosd' , & 'cosh' , 'coshape' , 'cospi' , 'count' , 'cpu_time' , 'cshift' , 'csin' , & 'csqrt' , 'dabs' , & 'dacos' , 'dasin' , 'datan' , 'datan2' , 'date_and_time' , 'dble' , 'dcos' , & 'dcosh' , 'ddim' , & 'dexp' , 'digits' , 'dim' , 'dint' , 'dlog' , 'dlog10' , 'dmax1' , 'dmin1' , & 'dmod' , 'dnint' , & 'dot_product' , 'dprod' , 'dshiftl' , 'dshiftr' , 'dsign' , 'dsin' , 'dsinh' , & 'dsqrt' , 'dtan' , & 'dtanh' , 'eoshift' , 'epsilon' , 'erf' , 'erfc' , 'erfc_scaled' , & 'event_query' , & 'execute_command_line' , 'exp' , 'exponent' , 'extends_type_of' , & 'f_c_string' , & 'failed_images' , 'findloc' , 'float' , 'floor' , 'fraction' , 'gamma' , & 'get_command' , & 'get_command_argument' , 'get_environment_variable' , 'get_team' , 'huge' , & 'hypot' , 'iabs' , & 'iachar' , 'iall' , 'iand' , 'iany' , 'ibclr' , 'ibits' , 'ibset' , 'ichar' , & 'idim' , 'idint' , & 'idnint' , 'ieor' , 'ifix' , 'image_index' , 'image_status' , 'index' , 'int' , & 'ior' , & 'iparity' , 'is_contiguous' , 'is_iostat_end' , 'is_iostat_eor' , 'ishft' , & 'ishftc' , 'isign' , & 'kind' , 'lbound' , 'lcobound' , 'leadz' , 'len' , 'len_trim' , 'lge' , 'lgt' , & 'lle' , 'llt' , & 'log' , 'log10' , 'log_gamma' , 'logical' , 'maskl' , 'maskr' , 'matmul' , & 'max' , 'max0' , & 'max1' , 'maxexponent' , 'maxloc' , 'maxval' , 'merge' , 'merge_bits' , 'min' , & 'min0' , 'min1' , & 'minexponent' , 'minloc' , 'minval' , 'mod' , 'modulo' , 'move_alloc' , & 'mvbits' , 'nearest' , & 'new_line' , 'nint' , 'norm2' , 'not' , 'null' , 'num_images' , & 'out_of_range' , 'pack' , & 'parity' , 'popcnt' , 'poppar' , 'precision' , 'present' , 'product' , & 'radix' , 'random_init' , & 'random_number' , 'random_seed' , 'range' , 'rank' , 'real' , 'reduce' , & 'repeat' , 'reshape' , & 'rrspacing' , 'same_type_as' , 'scale' , 'scan' , 'selected_char_kind' , & 'selected_int_kind' , & 'selected_logical_kind' , 'selected_real_kind' , 'set_exponent' , 'shape' , & 'shifta' , & 'shiftl' , 'shiftr' , 'sign' , 'sin' , 'sind' , 'sinh' , 'sinpi' , 'size' , & 'sngl' , 'spacing' , & 'split' , 'spread' , 'sqrt' , 'stopped_images' , 'storage_size' , 'sum' , & 'system_clock' , & 'tan' , 'tand' , 'tanh' , 'tanpi' , 'team_number' , 'this_image' , 'tiny' , & 'tokenize' , & 'trailz' , 'transfer' , 'transpose' , 'trim' , 'ubound' , 'ucobound' , & 'unpack' , 'verify' ] ! named constants and types of iso_fortran_env and iso_c_binding character ( len =* ), parameter :: INTRINSIC_CONSTANTS ( * ) = [ character ( len = 28 ) :: & 'atomic_int_kind' , 'atomic_logical_kind' , 'c_alert' , 'c_backspace' , & 'c_bool' , & 'c_carriage_return' , 'c_char' , 'c_double' , 'c_double_complex' , 'c_float' , & 'c_float128' , & 'c_float128_complex' , 'c_float_complex' , 'c_form_feed' , 'c_funptr' , & 'c_horizontal_tab' , & 'c_int' , 'c_int128_t' , 'c_int16_t' , 'c_int32_t' , 'c_int64_t' , 'c_int8_t' , & 'c_int_fast128_t' , 'c_int_fast16_t' , 'c_int_fast32_t' , 'c_int_fast64_t' , & 'c_int_fast8_t' , & 'c_int_least128_t' , 'c_int_least16_t' , 'c_int_least32_t' , & 'c_int_least64_t' , & 'c_int_least8_t' , 'c_intmax_t' , 'c_intptr_t' , 'c_long' , 'c_long_double' , & 'c_long_double_complex' , 'c_long_long' , 'c_new_line' , 'c_null_char' , & 'c_null_funptr' , & 'c_null_ptr' , 'c_ptr' , 'c_ptrdiff_t' , 'c_short' , 'c_signed_char' , & 'c_size_t' , & 'c_vertical_tab' , 'character_kinds' , 'character_storage_size' , & 'current_team' , & 'error_unit' , 'event_type' , 'file_storage_size' , 'initial_team' , & 'input_unit' , 'int16' , & 'int32' , 'int64' , 'int8' , 'integer_kinds' , 'iostat_end' , 'iostat_eor' , & 'iostat_inquire_internal_unit' , 'lock_type' , 'logical16' , 'logical32' , & 'logical64' , & 'logical8' , 'logical_kinds' , 'notify_type' , 'numeric_storage_size' , & 'output_unit' , & 'parent_team' , 'real128' , 'real16' , 'real32' , 'real64' , 'real_kinds' , & 'stat_failed_image' , 'stat_locked' , 'stat_locked_other_image' , & 'stat_stopped_image' , & 'stat_unlocked' , 'stat_unlocked_failed_image' , 'team_type' ] contains function compute_case ( source , views , opts ) result ( marks ) !! The letter case wanted for each token. type ( source_t ), intent ( in ) :: source !! the source type ( statement_view_t ), intent ( in ) :: views (:) !! the view of each item (see [[statement_views]]) type ( case_options_t ), intent ( in ) :: opts !! the case wanted for each category type ( case_marks_t ) :: marks integer :: k , t , a , b allocate ( marks % whole ( source % tokens % n ), marks % part ( source % tokens % n )) marks % whole = CASE_KEEP marks % part = CASE_KEEP do t = 1 , source % tokens % n associate ( tok => source % tokens % tok ( t )) select case ( tok % kind ) case ( TK_DOTOP ) marks % whole ( t ) = opts % operators case ( TK_INT , TK_REAL ) marks % whole ( t ) = opts % types ! their only letters: an exponent and a kind end select if ( opts % types /= CASE_KEEP . and . ( tok % kind == TK_DOTOP . or . tok % kind == TK_STRING )) then call kind_part ( source % text ( tok % first : tok % last ), tok % kind , a , b ) if ( b >= a ) marks % part ( t ) = opts % types end if end associate end do do k = 1 , source % stmts % n if ( source % stmts % s ( k )% kind /= SK_CODE ) cycle if ( opts % keywords /= CASE_KEEP ) call statement_case ( views ( k ), opts % keywords , marks % whole ) if ( opts % procedures /= CASE_KEEP . or . opts % constants /= CASE_KEEP . or . opts % types /= CASE_KEEP ) & call names_case ( views ( k ), opts , marks % whole ) end do end function compute_case pure subroutine kind_part ( text , kind , a , b ) !! Where the kind is in the text of a token of kind `kind`: `text(a:b)`, or `b < a` if it has none. !! For a logical constant it is the suffix (`_lk` in `.true._lk`), for a string the prefix (`ck` in !! `ck_'a'`). Numbers have letters only in their exponent and kind, so they are cased whole. character ( len =* ), intent ( in ) :: text !! the token's text integer , intent ( in ) :: kind !! its kind (`TK_*`) integer , intent ( out ) :: a , b !! the range of the kind in `text` integer :: p a = 1 b = 0 select case ( kind ) case ( TK_DOTOP ) p = index ( text , '.' , back = . true .) if ( p > 1 . and . p < len ( text )) then if ( text ( p + 1 : p + 1 ) == '_' ) then a = p + 2 b = len ( text ) end if end if case ( TK_STRING ) p = scan ( text , '\"' // \"'\" ) if ( p > 2 ) then if ( text ( p - 1 : p - 1 ) == '_' ) b = p - 2 end if end select end subroutine kind_part subroutine names_case ( v , opts , mode ) !! Mark the intrinsic procedures, the constants of the intrinsic modules and the kinds named in !! one code statement. type ( statement_view_t ), intent ( in ) :: v !! the statement type ( case_options_t ), intent ( in ) :: opts !! the case wanted for each category integer , intent ( inout ) :: mode (:) !! case mode of each token, set for the names integer :: j , first logical :: decl , use_stmt , entity if ( v % n == 0 ) return first = v % first if ( first + 1 < v % n ) then if ( v % kind_of ( first ) == TK_NAME . and . v % is ( first + 1 , ':' )) first = first + 2 ! construct name end if use_stmt = v % is ( first , 'use' ) decl = . false . if (. not . use_stmt ) decl = any ([( v % is ( j , '::' ) . and . v % depth ( j ) == 0 , j = 1 , v % n )]) entity = . false . ! after `::`, the next top-level name is an entity being declared do j = first , v % n if ( decl . and . v % depth ( j ) == 0 ) then if ( v % is ( j , '::' ) . or . ( entity . and . v % is ( j , ',' ))) then entity = . true . cycle end if end if if ( v % kinds ( j ) /= TK_NAME ) cycle if ( j == first ) cycle if ( v % is ( j - 1 , '%' )) cycle if ( decl . and . entity . and . v % depth ( j ) == 0 . and . ( v % is ( j - 1 , '::' ) . or . v % is ( j - 1 , ',' ))) cycle select case ( v % word ( j - 1 )) case ( 'function' , 'subroutine' , 'procedure' , 'entry' , 'program' , 'module' , 'submodule' , 'interface' ) cycle end select if ( opts % procedures /= CASE_KEEP . and . ( v % is ( j + 1 , '(' ) . or . v % is ( j - 1 , 'call' ))) then if ( any ( INTRINSIC_PROCEDURES == v % word ( j ))) mode ( v % code ( j )) = opts % procedures end if if ( opts % constants /= CASE_KEEP . and . . not . v % 