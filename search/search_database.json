buf integer :: k , j , r if ( style == REL_KEEP ) then out = src return end if call parse_source ( src , source ) do k = 1 , source % stmts % n do j = source % stmts % s ( k )% first , source % stmts % s ( k )% last r = 0 if (. not . source % keep ( k ) . and . source % stmts % s ( k )% kind == SK_CODE ) r = operator_index ( j ) if ( r == 0 ) then call buf % append ( token_text ( src , source % tokens % tok ( j ))) else if ( style == REL_SYMBOLS ) then call buf % append ( trim ( SYMBOLS ( r ))) else call buf % append ( trim ( LETTERS ( r ))) end if end do end do out = buf % get () contains integer function operator_index ( j ) !! Index of token `j` in the operator tables, or 0 if it is not a relational operator. integer , intent ( in ) :: j !! index into the token list character ( len = :), allocatable :: t operator_index = 0 if ( source % tokens % tok ( j )% kind /= TK_OP . and . source % tokens % tok ( j )% kind /= TK_DOTOP ) return t = token_lower ( src , source % tokens % tok ( j )) if ( source % tokens % tok ( j )% kind == TK_OP ) then operator_index = findloc ( SYMBOLS , t , dim = 1 ) if ( is_chevron ( src , source % tokens , j )) operator_index = 0 else operator_index = findloc ( LETTERS , t , dim = 1 ) end if end function operator_index end function convert_relational pure function canonical_relational ( text ) result ( t ) !! The symbol spelling of a lowercase relational operator; other text is returned unchanged. character ( len =* ), intent ( in ) :: text !! operator text, in lowercase character ( len = :), allocatable :: t integer :: r r = findloc ( LETTERS , text , dim = 1 ) if ( r > 0 ) then t = trim ( SYMBOLS ( r )) else t = text end if end function canonical_relational end module ffmt_relational","tags":"","url":"sourcefile/ffmt_relational.f90.html"},{"title":"ffmt_use_sort.f90 – fformat","text":"This file depends on sourcefile~~ffmt_use_sort.f90~~EfferentGraph sourcefile~ffmt_use_sort.f90 ffmt_use_sort.f90 sourcefile~ffmt_source.f90 ffmt_source.f90 