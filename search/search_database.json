 case ( s % kind ) case ( SK_BLANK ) call emit_blank ( w , src , tokens , s ) w % comment_in = - 1 w % stmt_in = - 1 case ( SK_PREPROC ) if ( opts % indent_fypp ) then call emit_fypp_line ( w , src , tokens , s , ind ) else call emit_range ( w , src , tokens , s % first , s % last ) end if w % comment_in = - 1 case ( SK_COMMENT ) call emit_comment_line ( w , src , tokens , s , ind , opts ) case ( SK_CODE ) call emit_statement ( w , src , tokens , s , st % info ( k )% label > 0 , ind , opts ) end select end associate end do end associate out = w % buf % get () if ( present ( long_lines )) long_lines = w % long_lines end function layout","tags":"","url":"proc/layout.html"},{"title":"line_width – fformat","text":"private  function line_width(w, src, tokens, first, lend) result(width) Width of tokens first:lend as they will be written on one line, without the line break and\nwithout a trailing comment (compilers only limit the length of the code). A comment on a line\nof its own counts. Arguments Type Intent Optional Attributes Name type( writer_t ), intent(in) :: w the output and the alignment state character(len=*), intent(in) :: src the source text type( token_list_t ), intent(in) :: tokens its tokens integer, intent(in) :: first first token of the part of the line to measure integer, intent(in) :: lend last token of the line, its line break if it has one Return Value integer Calls proc~~line_width~~CallsGraph proc~line_width line_width proc~line_pieces line_pieces proc~line_width->proc~line_pieces proc~utf8_width utf8_width proc~line_width->proc~utf8_width Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that inte