olumn ( source % tokens % tok ( t )% first ) end do do k = 1 , n if ( k > 1 ) then if ( line ( k - 1 ) == line ( k ) - 1 . and . col ( k - 1 ) == col ( k )) cycle end if if ( k < n ) then if ( line ( k + 1 ) == line ( k ) + 1 . and . col ( k + 1 ) == col ( k )) cycle end if gap ( tok ( k )) = spacing end do contains integer function column ( i ) !! Input column of byte `i`: the characters before it on its line. integer , intent ( in ) :: i !! index into the source text integer :: j j = scan ( source % text ( 1 : i - 1 ), achar ( 10 ) // achar ( 13 ), back = . true .) column = utf8_width ( source % text ( j + 1 : i - 1 )) end function column end subroutine comment_gaps","tags":"","url":"proc/comment_gaps.html"},{"title":"statement_gaps – fformat","text":"private  subroutine statement_gaps(src, tokens, v, ws, gap) Set the gaps wanted before the tokens of one code statement. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: src the source text type( token_list_t ), intent(in) :: tokens its tokens type( statement_view_t ), intent(in) :: v the statement type( whitespace_options_t ), intent(in) :: ws modes of the whitespace rules integer, intent(inout) :: gap (:) gap wanted before each token, set where a rule applies Calls proc~~statement_gaps~~CallsGraph proc~statement_gaps statement_gaps proc~is_chevron is_chevron proc~statement_gaps->proc~is_chevron proc~is_word is_word proc~statement_gaps->proc~is_word proc~view_kind_of statement_view_t%view_kind_of proc~statement_gaps->proc~view_kind_of proc~view_word statement_view_t%view_word proc~statement_gaps->proc~view_word Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to p