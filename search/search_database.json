on the command line type ( string_t ), allocatable , intent ( out ) :: files (:) !! paths of the files found integer , intent ( inout ) :: status !! exit status so far; set to `EXIT_ERROR` if the !! configuration cannot be read type ( config_t ) :: cfg type ( string_t ), allocatable :: extensions (:), exclude (:) integer :: stat character ( len = :), allocatable :: errmsg extensions = default_extensions () exclude = default_exclude () call config_for ( cli , cache , absolute_path ( dir ), cfg , stat , errmsg ) if ( stat /= 0 ) then write ( error_unit , '(a)' ) 'error: ' // errmsg status = EXIT_ERROR allocate ( files ( 0 )) return end if if ( allocated ( cfg % extensions )) extensions = cfg % extensions if ( allocated ( cfg % exclude )) exclude = cfg % exclude if ( allocated ( cli % extensions )) extensions = cli % extensions exclude = [ exclude , cli % exclude ] call collect_files ( dir , extensions , exclude , files ) end subroutine directory_files","tags":"","url":"proc/directory_files.html"},{"title":"options_for – fformat","text":"private  subroutine options_for(cli, cache, dir, opts, stat, errmsg) The options for a file in directory dir : defaults, then configuration, then command line. Arguments Type Intent Optional Attributes Name type( cli_t ), intent(in) :: cli the parsed command line type( config_cache_t ), intent(inout) :: cache configurations found so far character(len=*), intent(in) :: dir the file's directory, relative or absolute type( format_options_t ), intent(out) :: opts the options integer, intent(out) :: stat nonzero for an unreadable configuration or a bad setting character(len=:), intent(out), allocatable :: errmsg what is wrong, if stat is nonzero Calls proc~~options_for~~CallsGraph proc~options_for options_for proc~absolute_path absolute_path proc~options_for->proc~absolute_path proc~apply_setting apply_setting proc~options_for->proc~apply_setting proc~config_for config_for proc~options_for->proc~config_for proc~current_directory current_dir