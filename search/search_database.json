ens % tok ( t )), achar ( 10 ) // achar ( 13 )) > 0 . and . tokens % tok ( t )% kind /= TK_NEWLINE ) & return ! a token continued on the next line if ( tokens % tok ( t )% kind == TK_COMMENT ) exit if ( is_code_kind ( tokens % tok ( t )% kind ) . or . tokens % tok ( t )% kind == TK_CONT ) cend = t end do if ( cend == 0 ) return if ( end_column ( cend ) <= line_length ) return best_prio = huge ( 1 ) do p = a , cend - 1 if (. not . is_code_kind ( tokens % tok ( p )% kind )) cycle if ( p == a . and . tokens % tok ( p )% kind == TK_INT ) cycle ! a statement label q = p + 1 do while ( q <= cend ) if ( tokens % tok ( q )% kind /= TK_SPACE ) exit q = q + 1 end do if ( q > cend ) cycle if (. not . is_code_kind ( tokens % tok ( q )% kind ) . or . tokens % tok ( q )% glued ) cycle end_col = end_column ( p ) if ( end_col + 2 > line_length ) exit ! ` &` would not fit prio = priority ( token_lower ( src , tokens % tok ( p )), tokens % tok ( p )% kind ) if ( prio <= best_prio ) then best_prio = prio best = p end if end do contains integer function end_column ( t ) !! Column just after token `t`, for a line starting at token `a` in column `start_col`. integer , intent ( in ) :: t !! index into the token list end_column = start_col + utf8_width ( src ( tokens % tok ( a )% first : tokens % tok ( t )% last )) end function end_column end function break_point","tags":"","url":"proc/break_point.html"},{"title":"long_code_lines – fformat","text":"public  function long_code_lines(src, line_length) result(lines) Line numbers of code lines whose code (without a trailing comment) is longer than line_length ,\noutside protected code. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: src the source text integer, intent(in) :: line_length maximum line width, in characters; 0 or less for no limit Return Value integer, allocatable, (:) Calls proc~~long_code_lines~~CallsGraph proc~long_code_lines long_code_lines proc~parse_source parse_source proc~long_code_lines->proc