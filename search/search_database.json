nt ( out ) :: stat !! nonzero if a configuration file cannot be read character ( len = :), allocatable , intent ( out ) :: errmsg !! what is wrong, if `stat` is nonzero logical :: found integer :: k stat = 0 if ( cli % no_config ) then cfg % path = '' allocate ( cfg % settings ( 0 )) return end if if ( len ( cli % config ) > 0 ) then call load_config ( cli % config , ends_with ( cli % config , 'fpm.toml' ), cfg , found , stat , errmsg ) if ( stat == 0 . and . . not . found ) then stat = 1 errmsg = cli % config // ': no [extra.fformat] table' end if return end if do k = 1 , size ( cache % dirs ) if ( cache % dirs ( k )% s == dir . and . len ( cache % dirs ( k )% s ) == len ( dir )) then cfg = cache % configs ( k ) return end if end do call find_config ( dir , cfg , stat , errmsg ) if ( stat /= 0 ) return cache % dirs = [ cache % dirs , string_t ( dir )] cache % configs = [ cache % configs , cfg ] end subroutine config_for","tags":"","url":"proc/config_for.html"},{"title":"directory_files – fformat","text":"private  subroutine directory_files(cli, cache, dir, files, status) The Fortran files under dir , selected with the [files] settings of its configuration and\nthe command line. Arguments Type Intent Optional Attributes Name type( cli_t ), intent(in) :: cli the parsed command line type( config_cache_t ), intent(inout) :: cache configurations found so far character(len=*), intent(in) :: dir the directory, as given on the command line type( string_t ), intent(out), allocatable :: files (:) paths of the files found integer, intent(inout) :: status exit status so far; set to EXIT_ERROR if the\nconfiguration cannot be read Calls proc~~directory_files~~CallsGraph proc~directory_files directory_files proc~absolute_path absolute_path proc~directory_files->proc~absolute_path proc~collect_files collect_files proc~directory_files->proc~collect_files proc~config_for config_for proc~directory_files->proc~config_for proc~default_exclude default_exclude proc~directory_files->proc~