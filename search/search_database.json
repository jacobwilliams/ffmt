ck' , & 'critical' , 'change team' , 'where' , 'forall' , 'contains' , & 'enumeration type' ] type , public :: stmt_info_t !! What a statement does to the block structure, as found by `classify_statement`. integer :: role = ROLE_NONE !! `ROLE_OPEN`, `ROLE_MIDDLE`, `ROLE_CLOSE`, or `ROLE_NONE` for other statements integer :: construct = C_NONE !! the construct opened, continued or closed: one of the `C_*` constants integer :: label = 0 !! statement label, or 0 integer :: do_label = 0 !! for `do 10 ...`: the label of the statement that ends the loop character ( len = :), allocatable :: name !! construct name, as in `outer: do` end type stmt_info_t type :: words_t !! The words of a statement, with combined keywords such as `endif` split into `end`, `if`. type ( string_t ), allocatable :: w (:) !! the words of the first token; the others are its code tokens integer , allocatable :: tok (:) !! index into the code token list for each word integer :: n = 0 !! number of words end type words_t contains pure function construct_label ( construct ) result ( label ) !! Name of a construct for messages (`'if'`, `'select'`, `'end'` for a bare `end`), or `'?'`. integer , intent ( in ) :: construct !! one of the `C_*` constants character ( len = :), allocatable :: label if ( construct < 0 . or . construct > NCONSTRUCTS ) then label = '?' else label = trim ( LABELS ( construct )) end if end function construct_label function classify_statement ( src , tokens , v , in_interface ) result ( info ) !! Classify a code statement. `in_interface` is true directly inside an interface block, !! where `module procedure` lists procedures instead of starting one. character ( len =* ), intent ( in ) :: src !! source text type ( token_list_t ), intent ( in ) :: tokens !! tokens of `src` type ( statement_view_t ), intent ( in ) :: v !! the statement logical , intent ( in ) :: in_interface !! the innermost open construct is an interface block type ( stmt_info_t ) :: info type ( words_t ) :: wd integer