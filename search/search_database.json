 to try, best first; negative ones are skipped integer , intent ( in ), optional :: from !! first token written after the prefix; requires `prefix` integer , intent ( in ), optional :: prefix !! width of the text written before token `from` logical , intent ( in ), optional :: always_original !! try the original column even when lines are split integer :: k , width , ncand , first_piece logical :: original col = max ( 0 , candidates ( 1 )) if ( w % line_length <= 0 ) return original = w % keep_original if ( present ( always_original )) original = original . or . always_original ncand = size ( candidates ) if (. not . original . and . ncand > 1 ) ncand = ncand - 1 if ( present ( from )) then width = prefix + line_width ( w , src , tokens , from , lend ) else width = line_width ( w , src , tokens , f , lend ) end if first_piece = - 1 do k = 1 , ncand if ( candidates ( k ) < 0 ) cycle if (. not . original . and . k < ncand . and . candidates ( k ) + width > w % line_length ) then if ( first_piece < 0 ) then if ( present ( from )) then first_piece = prefix + first_piece_width ( w , src , tokens , from , lend ) else first_piece = first_piece_width ( w , src , tokens , f , lend ) end if end if if ( candidates ( k ) + first_piece + 2 <= w % line_length ) then ! ` &` after the first piece col = candidates ( k ) return end if end if if ( candidates ( k ) + width <= w % line_length ) then col = candidates ( k ) if ( original . and . k == size ( candidates ) . and . k > 1 . and . col /= candidates ( 1 )) & w % long_lines = [ w % long_lines , tokens % tok ( f )% line ] return end if end do col = max ( 0 , minval ( candidates ( 1 : ncand ))) ! too long: it is split later, or was too long already end function fitting_column","tags":"","url":"proc/fitting_column.html"},{"title":"input_column – fformat","text":"private pure function input_column(src, t) result(col) Column of token t in the input (characters before it on its line). Arguments Type Intent Optional Attributes Name char