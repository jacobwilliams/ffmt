ken_list_t ), public :: tokens its tokens Functions public  function statement_views (s) result(views) The view of each item of s (see set_views , which fills them in place, without a copy). Arguments Type Intent Optional Attributes Name type( source_t ), intent(in) :: s the source Return Value type( statement_view_t ), allocatable, (:) Subroutines public  subroutine parse_source (text, s) Read text into s : tokenize it, group the tokens into items and find the protected ones. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: text the source text type( source_t ), intent(out) :: s the result public  subroutine set_views (s, views) Make views the view of each item of s (see statement_view_t ); empty for items that are\nnot code. Arguments Type Intent Optional Attributes Name type( source_t ), intent(in) :: s the source type( statement_view_t ), intent(out), allocatable :: views (:) the views","tags":"","url":"module/ffmt_source.html"},{"title":"ffmt_fs – fformat","text":"Portable file system access that standard Fortran lacks: listing a directory and telling\ndirectories from files. Written in Fortran with interfaces to opendir , readdir and closedir ,\nwhich POSIX systems and MinGW-w64 (gfortran on Windows) provide. The layout of struct dirent differs between systems, and gfortran's preprocessor does not say\nwhich system it is compiling for, so the layout is found at run time: the offset of d_name is\nwhere the . and .. entries, which every listing has, show their names. The known layouts\nare Linux (offset 19), macOS (21), FreeBSD (24), and MinGW or macOS with 32-bit inodes (8).\nWhere the layout has a d_type field it is used; otherwise a directory is recognized by opening it. Uses iso_c_binding module~~ffmt_fs~~UsesGraph module~ffmt_fs ffmt_fs iso_c_binding iso_c_binding module~ffmt_fs->iso_c_binding Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~ffmt_fs~~UsedByGraph module~ffmt_fs ffmt_fs module~ffmt_cli ffmt_cli module~ffmt_cli->module~ffmt_fs module~ffmt_config ffmt_config module~ffmt_cli->module~ffmt_config module~ffmt_walk ffmt_walk module~ffmt_cli->module~ffmt_walk module~ffmt_config->module~ffmt_fs module~ffmt_walk->module~ffmt_fs Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Variables Type Visibility Attributes Name Initial integer, private, parameter :: DT_DIR = 4 integer, private, parameter :: DT_LNK = 10 integer, private, parameter :: DT_REG = 8 integer, private, parameter :: DT_UNKNOWN = 0 integer, public, parameter :: ENTRY_DIR = 2 a directory integer, public, parameter :: ENTRY_FILE = 1 a regular file (or a link to one) integer, public, parameter :: ENTRY_OTHER = 3 a link to a directory, or anything else integer, private, parameter :: MAX_NAME = 1024 integer, private, parameter :: NAME_OFFSETS (*) = [19, 21, 24, 8] offsets of d_name to try integer, private, parameter :: TYPE_OFFSETS (*) = [18, 20, 20, -1] matching offsets of d_type (-1: none) integer, private, save :: layout = 0 index into NAME_OFFSETS once known Interfaces interface private  function c_closedir(dir) result(status) bind(c, name='closedir')) C closedir : close dir ; 0 on success. Arguments Type Intent Optional Attributes Name type(c_ptr), value :: dir a directory opened by c_opendir Return Value integer(kind=c_int) interface private  function c_getcwd(buf, size) result(p) bind(c, name='getcwd')) C getcwd : write the current directory into buf , NUL-terminated; a null pointer if\nit does not fit or cannot be determined. Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(out) :: buf (*) receives the path integer(kind=c_size_t), value :: size size of buf in bytes Return Value type(c_ptr) interface private  function c_opendir(name) result(dir) bind(c, name='opendir')) C opendir : open directory name for reading; a null pointer if it cannot be opened. Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in) :: name (*) the path, NUL-terminated Return Value type(c_ptr) interface private  function c_readdir(dir) result(entry) bind(c, name='readdir')) C readdir : the next struct dirent of dir , or a null pointer at the end. Arguments Type Intent Optional Attributes Name type(c_ptr), value :: dir a directory opened by c_opendir Return Value type(c_ptr) Derived Types type, public :: dir_entry_t One entry of a directory listing. Components Type Visibility Attributes Name Initial integer, public :: kind = ENTRY_OTHER ENTRY_FILE , ENTRY_DIR or ENTRY_OTHER character(len=:), public, allocatable :: name the entry's name, without the directory Functions public  function absolute_path (path) result(abs) path made absolute by prefixing the current directory, unless it already is\n(starts with / or \\ , or a drive letter such as C: ). Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: path a relative or absolute path Return Value character(len=:), allocatable private  function byte_at (p, offset) result(b) The byte at offset in the memory at p , as a number from 0 to 255. Arguments Type Intent Optional Attributes Name type(c_ptr), intent(in) :: p start of the memory integer, intent(in) :: offset in bytes, 0 for the first byte Return Value integer private pure function c_string (s) result(c) s as a NUL-terminated C string. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: s the Fortran string Return Value character(kind=c_char, len=1), (len(s)+1) public  function current_directory () result(path) The current working directory, or . if it cannot be determined. Arguments None Return Value character(len=:), allocatable private  function entry_name (p) result(name) The NUL-terminated name in the directory entry at p . Arguments Type Intent Optional Attributes Name type(c_ptr), intent(in) :: p a struct dirent returned by c_readdir , with the layout known Return Value character(len=:), allocatable private pure function is_absolute (path) True if path starts with / or \\ , or has a drive letter such as C: . Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: path the path to test Return Value logical public  function is_directory (path) True if path is a directory (or a link to one): if it can be opened as a directory. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: path the path to test Return Value logical public pure function join_path (dir, name) result(path) dir/name , without doubling a separator. A trailing \\ or : (Windows) also counts. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: dir the directory, and the name to append to it character(len=*), intent(in) :: name the directory, and the name to append to it Return Value character(len=:), allocatable public pure function parent_directory (path) result(parent) The directory containing path ( /a/b for /a/b/c ), or '' if path has no parent. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: path a file or directory path Return Value character(len=:), allocatable Subroutines private  subroutine find_layout (path) Find the offset of d_name from the . and .. entries of directory path . Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: path a directory to list public  subroutine list_directory (path, entries, stat) The entries of directory path , without . and .. , in the order the system returns them.\nLinks to directories are reported as ENTRY_OTHER , so a walk does not follow them. stat is\nnonzero if the directory cannot be read, or its entries cannot be decoded. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: path the directory type( dir_entry_t ), intent(out), allocatable :: entries (:) the entries; empty if stat is nonzero integer, intent(out) :: stat 0, or 1 if the listing failed","tags":"","url":"module/ffmt_fs.html"},{"title":"ffmt_walk – fformat","text":"Finding the Fortran files under a directory. Files are selected by extension. Entries are excluded by glob patterns: * and ? match within\na path component, ** across components, and [abc] / [!abc] match one character. A pattern\nwithout a / is matched against an entry's name, one with a / against its path relative to\nthe directory being searched. Links to directories are not followed. Uses fregex ffmt_strings ffmt_fs module~~ffmt_walk~~UsesGraph module~ffmt_walk ffmt_walk fregex fregex module~ffmt_walk->fregex module~ffmt_fs ffmt_fs module~ffmt_walk->module~ffmt_fs module~ffmt_strings ffmt_strings module~ffmt_walk->module~ffmt_strings iso_c_binding iso_c_binding module~ffmt_fs->iso_c_binding Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~ffmt_walk~~UsedByGraph module~ffmt_walk ffmt_walk module~ffmt_cli ffmt_cli module~ffmt_cli->module~ffmt_walk Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Variables Type Visibility Attributes Name Initial integer, private, parameter :: MAX_DEPTH = 100 Functions private pure function child (dir, name) result(path) dir/name , or just name in the current directory. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: dir the directory, and the name of an entry in it character(len=*), intent(in) :: name the directory, and the name of an entry in it Return Value character(len=:), allocatable public  function default_exclude () result(list) Hidden files and directories, and fpm's build directory. Arguments None Return Value type( string_t ), allocatable, (:) public  function default_extensions () result(list) Extensions of free-form Fortran files. Arguments None Return Value type( string_t ), allocatable, (:) public  function glob_to_regex (glob) result(re) A regular expression (for a full match) equivalent to the glob pattern glob . Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: glob the glob pattern Return Value character(len=:), allocatable Subroutines public  subroutine collect_files (root, extensions, exclude, files) The files under directory root with one of the extensions (without the dot) that are not\nexcluded, sorted by path within each directory. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: root the directory to search type( string_t ), intent(in) :: extensions (:) extensions of the files to collect, without the dot type( string_t ), intent(in) :: exclude (:) glob patterns of the files and directories to skip type( string_t ), intent(out), allocatable :: files (:) paths of the files, root joined with their\nrelative paths (just those if root is . ) private  subroutine sort_entries (entries) Sort by name (insertion sort: directories are small). Arguments Type Intent Optional Attributes Name type( dir_entry_t ), intent(inout) :: entries (:) a directory listing","tags":"","url":"module/ffmt_walk.html"},{"title":"ffmt_constructs – fformat","text":"Classifies statements by their role in the block structure: opening a construct or program\nunit, continuing one ( else , case , contains , ...), or closing one. Classification looks only at a statement's code tokens. Keywords are not reserved in Fortran,\nso a keyword followed by = , => or % is treated as a variable ( end = 1 ). Uses ffmt_statements ffmt_strings ffmt_tokens module~~ffmt_constructs~~UsesGraph module~ffmt_constructs ffmt_constructs module~ffmt_statements ffmt_statements module~ffmt_constructs->module~ffmt_statements module~ffmt_strings ffmt_strings module~ffmt_constructs->module~ffmt_strings module~ffmt_tokens ffmt_tokens module~ffmt_constructs->module~ffmt_tokens module~ffmt_statements->module~ffmt_strings module~ffmt_statements->module~ffmt_tokens module~ffmt_tokens->module~ffmt_strings Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~ffmt_constructs~~UsedByGraph module~ffmt_constructs ffmt_constructs module~ffmt_structure ffmt_structure module~ffmt_structure->module~ffmt_constructs module~ffmt_format ffmt_format module~ffmt_format->module~ffmt_structure module~ffmt_layout ffmt_layout module~ffmt_format->module~ffmt_layout module~ffmt_layout->module~ffmt_structure module~ffmt_cli ffmt_cli module~ffmt_cli->module~ffmt_format Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Variables Type Visibility Attributes Name Initial integer, public, parameter :: C_ANY = 1 a bare end integer, public, parameter :: C_ASSOCIATE = 15 integer, public, parameter :: C_BLOCK = 16 integer, public, parameter :: C_BLOCK_DATA = 8 integer, public, parameter :: C_CONTAINS = 21 contains (a middle statement of program units and types) integer, public, parameter :: C_CRITICAL = 17 integer, public, parameter :: C_DO = 13 integer, public, parameter :: C_ENUM = 11 integer, public, parameter :: C_ENUMERATION = 22 enumeration type (F2023) integer, public, parameter :: C_FORALL = 20 integer, public, parameter :: C_FUNCTION = 6 integer, public, parameter :: C_IF = 12 integer, public, parameter :: C_INTERFACE = 9 integer, public, parameter :: C_MODULE = 3 integer, public, parameter :: C_NONE = 0 no construct integer, public, parameter :: C_PROCEDURE = 7 separate module procedure ( module procedure name in a submodule) integer, public, parameter :: C_PROGRAM = 2 integer, public, parameter :: C_SELECT = 14 integer, public, parameter :: C_SUBMODULE = 4 integer, public, parameter :: C_SUBROUTINE = 5 integer, public, parameter :: C_TEAM = 18 integer, public, parameter :: C_TYPE = 10 integer, public, parameter :: C_WHERE = 19 character(len=*), private, parameter :: LABELS (0:NCONSTRUCTS) = [character(len=16)::'none', 'end', 'program', 'module', 'submodule', 'subroutine', 'function', 'procedure', 'block data', 'interface', 'type', 'enum', 'if', 'do', 'select', 'associate', 'block', 'critical', 'change team', 'where', 'forall', 'contains', 'enumeration type'] integer, private, parameter :: NCONSTRUCTS = 22 integer, public, parameter :: ROLE_CLOSE = 3 integer, public, parameter :: ROLE_MIDDLE = 2 integer, public, parameter :: ROLE_NONE = 0 integer, public, parameter :: ROLE_OPEN = 1 Derived Types type, public :: stmt_info_t What a statement does to the block structure, as found by classify_statement . Components Type Visibility Attributes Name Initial integer, public :: construct = C_NONE the construct opened, continued or closed: one of the C_* constants integer, public :: do_label = 0 for do 10 ... : the label of the statement that ends the loop integer, public :: label = 0 statement label, or 0 character(len=:), public, allocatable :: name construct name, as in outer: do integer, public :: role = ROLE_NONE ROLE_OPEN , ROLE_MIDDLE , ROLE_CLOSE , or ROLE_NONE for other statements type, private :: words_t The words of a statement, with combined keywords such as endif split into end , if . Components Type Visibility Attributes Name Initial integer, public :: n = 0 number of words integer, public, allocatable :: tok (:) index into the code token list for each word type( string_t ), public, allocatable :: w (:) the words of the first token; the others are its code tokens Functions public  function classify_statement (src, tokens, v, in_interface) result(info) Classify a code statement. in_interface is true directly inside an interface block,\nwhere module procedure lists procedures instead of starting one. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: src source text type( token_list_t ), intent(in) :: tokens tokens of src type( statement_view_t ), intent(in) :: v the statement logical, intent(in) :: in_interface the innermost open construct is an interface block Return Value type( stmt_info_t ) public pure function closed_construct (second, third) result(construct) The construct that end second third closes ( C_ANY for a bare end ), or C_NONE if second names no construct, so that the end is not a closing statement. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: second the word after end , in lowercase, or '' character(len=*), intent(in) :: third the word after that, or '' ( data in end block data ) Return Value integer public pure function construct_label (construct) result(label) Name of a construct for messages ( 'if' , 'select' , 'end' for a bare end ), or '?' . Arguments Type Intent Optional Attributes Name integer, intent(in) :: construct one of the C_* constants Return Value character(len=:), allocatable private pure function expand_keyword (w) result(parts) Split a keyword that may be written as one word ( endif , elseif , selectcase , endblockdata , ...) into its parts. Other words are returned unchanged. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: w the word, in lowercase Return Value type( string_t ), allocatable, (:) Subroutines private pure subroutine set (info, role, construct) Set the role and construct of info . Arguments Type Intent Optional Attributes Name type( stmt_info_t ), intent(inout) :: info the classification to update integer, intent(in) :: role one of the ROLE_* constants integer, intent(in) :: construct one of the C_* constants","tags":"","url":"module/ffmt_constructs.html"},{"title":"ffmt_diff – fformat","text":"Unified diffs of two texts, for --diff . Lines are matched with a longest common subsequence computed by Hirschberg's algorithm, which\nneeds memory linear in the number of lines, so a diff of a file whose every line changed is\nstill cheap. Lines are compared as integers after hashing. Uses iso_fortran_env ffmt_strings module~~ffmt_diff~~UsesGraph module~ffmt_diff ffmt_diff iso_fortran_env iso_fortran_env module~ffmt_diff->iso_fortran_env module~ffmt_strings ffmt_strings module~ffmt_diff->module~ffmt_strings Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~ffmt_diff~~UsedByGraph module~ffmt_diff ffmt_diff module~ffmt_cli ffmt_cli module~ffmt_cli->module~ffmt_diff Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Variables Type Visibility Attributes Name Initial integer, private, parameter :: OP_DELETE = 1 integer, private, parameter :: OP_EQUAL = 0 integer, private, parameter :: OP_INSERT = 2 Derived Types type, private :: edit_t The edits that turn the lines of one text into those of the other, in order. Components Type Visibility Attributes Name Initial integer, public :: n = 0 number of edits in op integer, public, allocatable :: op (:) OP_EQUAL, OP_DELETE (line of a) or OP_INSERT (line of b) Functions private pure function hash (s) result(h) FNV-1a hash. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: s the bytes to hash Return Value integer(kind=int64) private pure function lcs_lengths (a, b) result(row) row(k) : the length of the longest common subsequence of a and b(1:k) . Arguments Type Intent Optional Attributes Name integer, intent(in) :: a (:) line numbers of the two texts integer, intent(in) :: b (:) line numbers of the two texts Return Value integer, (0:size(b)) private pure function range_text (start, n) result(text) start,n for a hunk header; start is the line before the hunk when it is empty. Arguments Type Intent Optional Attributes Name integer, intent(in) :: start first line of the hunk integer, intent(in) :: n number of lines in the hunk Return Value character(len=:), allocatable private  function split_lines (text) result(lines) The lines of text , each with its line ending (the last one may have none). Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: text the text Return Value type( string_t ), allocatable, (:) public  function unified_diff (a, b, name, context) result(diff) The changes from a to b as a unified diff with context lines of context (default 3),\nwith name in the headers. Empty if the texts are equal. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: a the old text character(len=*), intent(in) :: b the new text character(len=*), intent(in) :: name file name for the --- and +++ headers integer, intent(in), optional :: context number of unchanged lines shown around each change Return Value character(len=:), allocatable Subroutines private recursive subroutine lcs (a, a0, a1, b, b0, b1, e) Append the edits that turn a(a0:a1) into b(b0:b1) along a longest common subsequence\n(Hirschberg's algorithm). Arguments Type Intent Optional Attributes Name integer, intent(in) :: a (:) line numbers of the two texts, from line_ids integer, intent(in) :: a0 the ranges of a and b to compare integer, intent(in) :: a1 the ranges of a and b to compare integer, intent(in) :: b (:) line numbers of the two texts, from line_ids integer, intent(in) :: b0 the ranges of a and b to compare integer, intent(in) :: b1 the ranges of a and b to compare type( edit_t ), intent(inout) :: e the edits so far; e%op must have room for the new ones private  subroutine line_ids (la, lb, ia, ib) Number the distinct lines, so that equal lines have equal numbers. Arguments Type Intent Optional Attributes Name type( string_t ), intent(in) :: la (:) the lines of the two texts type( string_t ), intent(in) :: lb (:) the lines of the two texts integer, intent(out), allocatable :: ia (:) the number of each line of la and lb integer, intent(out), allocatable :: ib (:) the number of each line of la and lb","tags":"","url":"module/ffmt_diff.html"},{"title":"ffmt_settings – fformat","text":"Named settings, as written in a config file or given on the command line, applied to the options. Setting Values indent , base-indent , continuatio