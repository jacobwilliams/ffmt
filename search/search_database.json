then if ( src ( q - 1 : q - 1 ) == achar ( 13 )) q = q - 1 end if call check_width ( tk , col + utf8_width ( src ( p : q - 1 )), line ) col = 0 line = line + 1 p = p + index ( src ( p : tk % last ), achar ( 10 )) end do col = col + utf8_width ( src ( p : tk % last )) call check_width ( tk , col , line ) end associate end do end do contains subroutine check_width ( tk , width , line ) !! Record `line` if it holds code token `tk` and its code is `width` characters wide, too long. type ( token_t ), intent ( in ) :: tk !! the token integer , intent ( in ) :: width !! width of the line up to the end of `tk` on it integer , intent ( in ) :: line !! line number if ( is_code_kind ( tk % kind ) . and . width > line_length . and . line /= last_line ) then lines = [ lines , line ] last_line = line end if end subroutine check_width integer function start_column ( t ) !! Column of token `t`: the width of the text before it on its line. integer , intent ( in ) :: t !! index into the token list integer :: i i = scan ( src ( 1 : source % tokens % tok ( t )% first - 1 ), achar ( 10 ) // achar ( 13 ), back = . true .) start_column = utf8_width ( src ( i + 1 : source % tokens % tok ( t )% first - 1 )) end function start_column end function long_code_lines","tags":"","url":"proc/long_code_lines.html"},{"title":"priority – fformat","text":"private pure function priority(text, kind) result(prio) How good a place the end of a token with this text is for a line break (1 is best). Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: text lowercase text of the token integer, intent(in) :: kind token kind ( TK_* ) Return Value integer Called by proc~~priority~~CalledByGraph proc~priority priority proc~break_point break_point proc~break_point->proc~priority proc~split_long_lines split_long_lines proc~split_long_lines->proc~break_point proc~format_text format_text proc~format_text->proc~split_long_lines proc~process_text process_text proc~process_text->proc~format_text