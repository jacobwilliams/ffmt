k = 1 , len ( src ) c = iand ( ichar ( src ( k : k )), 255 ) if ( c == 10 ) then line = line + 1 width = 0 else if ( c < 128 . or . c >= 192 ) then width = width + 1 if ( width == MAX_LINE + 1 ) diags = [ diags , diagnostic_t ( line , 'line ' // to_s ( line ) // & ' is longer than ' // to_s ( MAX_LINE ) // ' characters, ' // & 'the limit of the Fortran standard' )] end if end do end if if ( len ( src ) <= MAX_STATEMENT ) return call parse_source ( src , source ) do k = 1 , source % stmts % n if ( source % stmts % s ( k )% kind /= SK_CODE ) cycle n = 0 do j = source % stmts % s ( k )% first , source % stmts % s ( k )% last associate ( t => source % tokens % tok ( j )) if ( t % kind /= TK_COMMENT . and . t % kind /= TK_NEWLINE ) n = n + t % last - t % first + 1 end associate end do if ( n > MAX_STATEMENT ) then line = source % tokens % tok ( source % stmts % s ( k )% first )% line diags = [ diags , diagnostic_t ( line , 'the statement on line ' // to_s ( line ) // ' has more than ' // & to_s ( MAX_STATEMENT ) // ' characters, the limit of the Fortran standard' )] end if end do end function limit_diagnostics","tags":"","url":"proc/limit_diagnostics.html"},{"title":"longest_code – fformat","text":"public pure function longest_code(text) result(width) An upper bound of the width of the longest code line of text : the characters of each line\nbefore a comment, without the blanks before it, as long_code_lines counts them.\nPreprocessor lines do not count. Strings are followed across continuation lines, so that a ! inside one does not end the code, but the scan does not tokenize, so it may count more\nthan a token-based count would; never less. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: text the formatted text Return Value integer Called by proc~~longest_code~~CalledByGraph proc~longest_code longest_code proc~too_long too_long proc~too_long->proc~longest_code proc~format_text format_text proc~format_text->proc~too_long proc~process_text p