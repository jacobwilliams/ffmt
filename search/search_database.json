 :: first = 1 !! first token integer :: last = 0 !! last token end type statement_t type , public :: statement_list_t !! The items of a source text, in order. type ( statement_t ), allocatable :: s (:) !! storage; only `s(1:n)` is in use integer :: n = 0 !! number of items contains procedure :: push !! append an item end type statement_list_t type , public :: statement_view_t !! The code tokens of one statement, with their lowercase text and bracket depth: what the rules !! that read a statement word by word need. The procedures take an index `j` into `code(:)`; !! outside `1:n` a word is `''` and its kind 0, so a rule can look before and after a token !! without checking the bounds. integer , allocatable :: code (:) !! indices into the token list of the code tokens !! (see [[code_tokens]]) integer :: n = 0 !! number of code tokens integer :: first = 1 !! first code token after a statement label (`10 continue`) integer , allocatable :: kinds (:) !! kind of each code token (`TK_*`) integer , allocatable :: depth (:) !! open `(` and `[` around each code token; a bracket is !! outside its own pair character ( len = :), allocatable :: low !! lowercase text of the code tokens, one after another integer , allocatable :: lo (:) !! where the text of each code token starts in `low` integer , allocatable :: hi (:) !! where it ends contains procedure :: word => view_word !! lowercase text of a code token procedure :: is => view_is !! whether a code token's lowercase text is a given one procedure :: kind_of => view_kind_of !! kind of a code token procedure :: closing => view_closing !! the `)` that closes a `(` end type statement_view_t contains subroutine split_statements ( src , tokens , stmts ) !! Group `tokens` into code statements and standalone blank, comment and preprocessor lines. character ( len =* ), intent ( in ) :: src !! source text type ( token_list_t ), intent ( in ) :: tokens !! tokens of `src` type ( statement_list_t ), intent ( out ) :: stmts !! the items, covering every token once integer :: i , lend , start , semi , kind allocate ( stmts % s ( 64 )) i = 1 do while ( i <= tokens % n ) lend = line_end_token ( tokens , i ) kind = line_kind ( tokens , i , lend ) if ( kind /= SK_CODE ) then call stmts % push ( statement_t ( kind , i , lend )) i = lend + 1 cycle end if start = i do ! a `;` with more code after it ends the statement within the line semi = find_semicolon ( src , tokens , i , lend ) if ( semi > 0 ) then call stmts % push ( statement_t ( SK_CODE , start , semi )) i = semi + 1 start = i cycle end if if (. not . ends_with_continuation ( tokens , i , lend )) exit ! continued: take in the next code line and any comment, blank or preprocessor lines before it do i = lend + 1 if ( i > tokens % n ) exit lend = line_end_token ( tokens , i ) if ( line_kind ( tokens , i , lend ) == SK_CODE ) exit end do if ( i > tokens % n ) then lend = tokens % n exit end if end do call stmts % push ( statement_t ( SK_CODE , start , lend )) i = lend + 1 end do end subroutine split_statements function code_tokens ( src , tokens , stmt ) result ( idx ) !! Indices of the code tokens of a statement: no blanks, line breaks, comments, continuation !! markers, preprocessor lines or `;` separators. character ( len =* ), intent ( in ) :: src !! source text type ( token_list_t ), intent ( in ) :: tokens !! tokens of `src` type ( statement_t ), intent ( in ) :: stmt !! the statement integer , allocatable :: idx (:) integer :: k , n allocate ( idx ( stmt % last - stmt % first + 1 )) n = 0 do k = stmt % first , stmt % last if (. not . is_code_kind ( tokens % tok ( k )% kind )) cycle if ( tokens % tok ( k )% kind == TK_OP ) then if ( src ( tokens % tok ( k )% first : tokens % tok ( k )% last ) == ';' ) cycle end if n = n + 1 idx ( n ) = k end do idx = idx ( 1 : n ) end function code_tokens function statement_view ( src , tokens , stmt ) result ( v ) !! The view of code statement `stmt` (see [[set_view]], which fills one in place, without a copy). chara