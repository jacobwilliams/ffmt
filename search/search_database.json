x ( 1 , last_nonblank ): max ( 1 , last_nonblank )) == '&' )) & quote = ' ' w = 0 code_w = 0 line_start = . true . skip = . false . in_comment = . false . last_nonblank = 0 cycle end if if ( skip . or . in_comment ) cycle if ( c >= 128 . and . c < 192 ) cycle ! a UTF-8 continuation byte w = w + 1 if ( text ( k : k ) == ' ' . or . text ( k : k ) == achar ( 9 )) cycle if ( line_start ) then line_start = . false . if ( quote == ' ' . and . ( text ( k : k ) == '#' . or . ( index ( '$@' , text ( k : k )) > 0 . and . & text ( min ( k + 1 , len ( text )): min ( k + 1 , len ( text ))) == ':' ))) then skip = . true . ! a preprocessor line cycle end if end if if ( quote /= ' ' ) then if ( text ( k : k ) == quote ) quote = ' ' ! a doubled quote reopens at once else if ( text ( k : k ) == '\"' . or . text ( k : k ) == \"'\" ) then quote = text ( k : k ) else if ( text ( k : k ) == '!' ) then in_comment = . true . cycle end if code_w = w last_nonblank = k end do width = max ( width , code_w ) end function longest_code","tags":"","url":"proc/longest_code.html"},{"title":"longest_line – fformat","text":"private pure function longest_line(text) result(width) Width of the longest line of text , in characters (as utf8_width counts them). Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: text text whose lines end with LF Return Value integer Called by proc~~longest_line~~CalledByGraph proc~longest_line longest_line proc~limit_diagnostics limit_diagnostics proc~limit_diagnostics->proc~longest_line proc~format_text format_text proc~format_text->proc~limit_diagnostics proc~process_text process_text proc~process_text->proc~format_text proc~process_file process_file proc~process_file->proc~process_text proc~process_stdin process_stdin proc~process_stdin->proc~process_text proc~run run proc~run->proc~process_file proc~run->proc~process_stdin Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Inter