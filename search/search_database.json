irectory to list type ( c_ptr ) :: dir , p logical :: dot ( size ( NAME_OFFSETS )), dotdot ( size ( NAME_OFFSETS )) integer :: k , status dir = c_opendir ( c_string ( path )) if (. not . c_associated ( dir )) return dot = . false . dotdot = . false . do p = c_readdir ( dir ) if (. not . c_associated ( p )) exit do k = 1 , size ( NAME_OFFSETS ) if ( byte_at ( p , NAME_OFFSETS ( k )) /= iachar ( '.' )) cycle if ( byte_at ( p , NAME_OFFSETS ( k ) + 1 ) == 0 ) dot ( k ) = . true . if ( byte_at ( p , NAME_OFFSETS ( k ) + 1 ) == iachar ( '.' ) . and . byte_at ( p , NAME_OFFSETS ( k ) + 2 ) == 0 ) & dotdot ( k ) = . true . end do end do status = c_closedir ( dir ) do k = 1 , size ( NAME_OFFSETS ) if ( dot ( k ) . and . dotdot ( k )) then layout = k return end if end do end subroutine find_layout","tags":"","url":"proc/find_layout.html"},{"title":"list_directory – fformat","text":"public  subroutine list_directory(path, entries, stat) The entries of directory path , without . and .. , in the order the system returns them.\nLinks to directories are reported as ENTRY_OTHER , so a walk does not follow them. stat is\nnonzero if the directory cannot be read, or its entries cannot be decoded. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: path the directory type( dir_entry_t ), intent(out), allocatable :: entries (:) the entries; empty if stat is nonzero integer, intent(out) :: stat 0, or 1 if the listing failed Calls proc~~list_directory~~CallsGraph proc~list_directory list_directory interface~c_closedir c_closedir proc~list_directory->interface~c_closedir interface~c_opendir c_opendir proc~list_directory->interface~c_opendir interface~c_readdir c_readdir proc~list_directory->interface~c_readdir proc~byte_at byte_at proc~list_directory->proc~byte_at proc~c_string c_string proc~list_directory->proc~c_string proc~entry_name entry_name proc~list_directory->proc~entry_name proc~find_layout find_layout proc~list_directory->proc~find_layout proc~is_dire