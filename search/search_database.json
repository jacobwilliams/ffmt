 opts % spaces , opts % comment_spacing ), & compute_case ( source , views , opts % letter_case ), opts , long_lines ) do k = 1 , size ( long_lines ) diags = [ diags , diagnostic_t ( long_lines ( k ), 'indentation kept: the line would be longer than ' // & to_s ( opts % line_length ) // ' characters' )] end do if ( present ( src_tokens )) then call move_alloc ( source % tokens % tok , src_tokens % tok ) src_tokens % n = source % tokens % n end if end subroutine format_pass","tags":"","url":"proc/format_pass.html"},{"title":"format_text – fformat","text":"public  subroutine format_text(src, opts, out, stat, errmsg, diags) Format src . On success out is the formatted text and stat is FMT_OK . As a safety check, the code tokens of the result are compared with those of the input. If they\ndiffer, which would be a bug in the formatter, out is the unchanged input and stat is FMT_ERR_INTERNAL . Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: src source text to format type( format_options_t ), intent(in) :: opts formatting options character(len=:), intent(out), allocatable :: out the formatted text integer, intent(out) :: stat FMT_OK or FMT_ERR_INTERNAL character(len=:), intent(out), allocatable :: errmsg error message; unallocated if stat is FMT_OK type( diagnostic_t ), intent(out), optional, allocatable :: diags (:) problems found while formatting Calls proc~~format_text~~CallsGraph proc~format_text format_text proc~convert_relational convert_relational proc~format_text->proc~convert_relational proc~format_pass format_pass proc~format_text->proc~format_pass proc~limit_diagnostics limit_diagnostics proc~format_text->proc~limit_diagnostics proc~long_code_lines long_code_lines proc~format_text->proc~long_code_lines proc~relayout relayout proc~format_text->proc~relayout proc~sort_use sort_use proc~format_text->proc~sort_use proc~split_long_lines split_long_lines proc~format_text->proc~split_long_lines proc~to_s to_s proc~format_text->proc~to_s p