t with the letter case applied), tracking brackets, !! anchors and trailing comments. integer , intent ( in ) :: t !! index into the token list character ( len =* ), intent ( in ) :: text !! the text to write if ( tokens % tok ( t )% kind == TK_COMMENT ) then if (. not . w % line_comment ) then ! a trailing comment: later lines may line up with it w % comment_in = input_column ( src , tokens % tok ( t )) w % comment_out = w % col w % line_comment = . true . end if end if if (. not . is_code_kind ( tokens % tok ( t )% kind )) then call put ( w , text ) return end if if ( w % pending_bracket ) w % bracket_first ( w % nbrackets ) = w % col if ( w % pending_anchor > 0 ) w % anchor_col ( w % pending_anchor ) = w % col w % pending_bracket = . false . w % pending_anchor = 0 call put ( w , text ) if ( tokens % tok ( t )% kind == TK_OP ) then select case ( text ) case ( '(' , '[' ) if (. not . allocated ( w % bracket_first )) allocate ( w % bracket_first ( 16 )) if ( w % nbrackets == size ( w % bracket_first )) w % bracket_first = [ w % bracket_first , w % bracket_first ] w % nbrackets = w % nbrackets + 1 w % bracket_first ( w % nbrackets ) = - 1 w % pending_bracket = . true . case ( ')' , ']' ) if ( w % nbrackets > 0 ) w % nbrackets = w % nbrackets - 1 case default if ( w % nbrackets == 0 ) call top_level_operator ( text ) end select end if w % prev = t end subroutine write_token subroutine top_level_operator ( op ) !! Record alignment anchors at a top-level operator. character ( len =* ), intent ( in ) :: op !! text of the operator select case ( op ) case ( '=' , '=>' ) ! an assignment, unless a `,` or `:` came first (`use m, only: a => b`, `integer :: n = 1`), ! or the bindings of `generic :: name => a, b` if (. not . w % separated ) then call anchor ( ANCHOR_ASSIGN ) else if ( op == '=>' . and . w % generic . and . w % declaration ) then call anchor ( ANCHOR_ASSIGN ) end if case ( '::' ) call anchor ( ANCHOR_DECL ) w % separated = . true . w % declaration = . true . case ( ':' ) if ( w % prev > 0 ) then if ( token_lower ( src , tokens % tok ( w % prev )) == 'only' ) call anchor ( ANCHOR_ONLY ) end if w % separated = . true . case ( ',' ) w % separated = . true . end select end subroutine top_level_operator subroutine anchor ( a ) !! Make the next code token the first item after anchor `a`, unless that anchor is already set. integer , intent ( in ) :: a !! `ANCHOR_ASSIGN`, `ANCHOR_ONLY` or `ANCHOR_DECL` if ( w % anchor_col ( a ) < 0 ) w % pending_anchor = a end subroutine anchor end subroutine emit_body pure integer function first_non_blank ( tokens , first , last ) result ( f ) !! First token in `first:last` that is not a blank, or `last + 1`. type ( token_list_t ), intent ( in ) :: tokens !! the token list integer , intent ( in ) :: first , last !! the token range to search do f = first , last if ( tokens % tok ( f )% kind /= TK_SPACE ) return end do f = last + 1 end function first_non_blank pure function to_case ( text , upper ) result ( t ) !! `text` in ASCII upper or lower case. character ( len =* ), intent ( in ) :: text !! the text to convert logical , intent ( in ) :: upper !! true for upper case, false for lower case character ( len = len ( text )) :: t integer :: k , c t = text do k = 1 , len ( t ) c = iachar ( t ( k : k )) if ( upper . and . c >= iachar ( 'a' ) . and . c <= iachar ( 'z' )) t ( k : k ) = achar ( c - 32 ) if (. not . upper . and . c >= iachar ( 'A' ) . and . c <= iachar ( 'Z' )) t ( k : k ) = achar ( c + 32 ) end do end function to_case pure function trim_blanks ( text ) result ( t ) !! `text` without trailing blanks and tabs. character ( len =* ), intent ( in ) :: text !! the text to trim character ( len = :), allocatable :: t integer :: n n = len ( text ) do while ( n > 0 ) if ( text ( n : n ) /= ' ' . and . text ( n : n ) /= achar ( 9 )) exit n = n - 1 end do t = text ( 1 : n ) end function trim_blanks end module ffmt_layout","tags":"","url":"sourcefile/ffmt_layout.f90.html"},{"title":"ffmt_source.f90 – 