llocatable :: key !! the name, e.g. `indent` or `spaces.comma` character ( len = :), allocatable :: value !! the value, e.g. `4`, `true` or `add` end type setting_t contains subroutine apply_setting ( opts , key , value , stat , errmsg ) !! Apply one setting to `opts`. `stat` is nonzero, with a message, for an unknown setting or a bad value. type ( format_options_t ), intent ( inout ) :: opts !! the options to change character ( len =* ), intent ( in ) :: key !! setting name, as in the table above character ( len =* ), intent ( in ) :: value !! its value as text integer , intent ( out ) :: stat !! 0, or 1 for an unknown setting or a bad value character ( len = :), allocatable , intent ( out ) :: errmsg !! what is wrong, if `stat` is nonzero stat = 0 select case ( key ) case ( 'indent' ) call read_count ( 64 , opts % indent ) case ( 'base-indent' ) call read_count ( 64 , opts % base_indent ) case ( 'continuation-indent' ) call read_count ( 64 , opts % continuation_indent ) case ( 'line-length' ) call read_count ( 100000 , opts % line_length ) case ( 'indent-units' ) call read_flag ( opts % indent_units ) case ( 'indent-procedures' ) call read_flag ( opts % indent_procedures ) case ( 'indent-fypp' ) call read_flag ( opts % indent_fypp ) case ( 'indent-comments' ) call read_flag ( opts % indent_comments ) case ( 'column1-comments' ) select case ( value ) case ( 'keep' ) opts % keep_column1_comments = . true . case ( 'indent' ) opts % keep_column1_comments = . false . case default call fail ( '\"keep\" or \"indent\"' ) end select case ( 'split' ) call read_flag ( opts % split_lines ) case ( 'sort-use' ) call read_flag ( opts % sort_use ) case ( 'sort-use-only' ) call read_flag ( opts % sort_use_only ) case ( 'comment-spacing' ) if ( value == 'keep' ) then opts % comment_spacing = - 1 else call read_count ( 64 , opts % comment_spacing ) if ( stat /= 0 ) errmsg = 'expected a number from 0 to 64 or keep for \"' // key // '\", not \"' // value // '\"' end if case ( 'continuation' ) select case ( value ) case ( 'align' ) opts % continuation = CONT_ALIGN case ( 'indent' ) opts % continuation = CONT_INDENT case default call fail ( '\"align\" or \"indent\"' ) end select case ( 'relational' ) select case ( value ) case ( 'symbols' ) opts % relational = REL_SYMBOLS case ( 'letters' ) opts % relational = REL_LETTERS case ( 'keep' ) opts % relational = REL_KEEP case default call fail ( '\"symbols\", \"letters\" or \"keep\"' ) end select case default if ( index ( key , 'spaces.' ) == 1 ) then call set_spaces ( key ( 8 :)) else if ( index ( key , 'case.' ) == 1 ) then call set_case ( key ( 6 :)) else stat = 1 errmsg = 'unknown setting \"' // key // '\"' end if end select contains subroutine fail ( expected ) !! Report a bad value for the setting. character ( len =* ), intent ( in ) :: expected !! description of the values allowed stat = 1 errmsg = 'expected ' // expected // ' for \"' // key // '\", not \"' // value // '\"' end subroutine fail subroutine read_count ( max_value , n ) !! Read the value as a whole number from 0 to `max_value` into `n`; `n` is unchanged if it is not one. integer , intent ( in ) :: max_value !! largest value allowed integer , intent ( inout ) :: n !! the option to set integer :: ios , v if ( verify ( value , '0123456789' ) == 0 . and . len ( value ) > 0 . and . len ( value ) <= 9 ) then read ( value , * , iostat = ios ) v if ( ios == 0 . and . v <= max_value ) then n = v return end if end if call fail ( 'a number from 0 to ' // to_s ( max_value )) end subroutine read_count subroutine read_flag ( flag ) !! Read the value, `true` or `false`, into `flag`; `flag` is unchanged if it is neither. logical , intent ( inout ) :: flag !! the option to set select case ( value ) case ( 'true' ) flag = . true . case ( 'false' ) flag = . false . case default call fail ( 'true or false' ) end select end subroutine read_flag subroutine set_spaces ( rule ) !! Set whitespace rule `rule` of `opts%spaces` (all rules for `all`) to the value: `add`, !! `remove` or `keep`. character ( len =* ), intent ( in ) :: rule !! rule name, the key without `spaces.`, e.g. `comma` integer :: mode select case ( value ) case ( 'add' ) mode = WS_ADD case ( 'remove' ) mode = WS_REMOVE case ( 'keep' ) mode = WS_KEEP case default call fail ( 'add, remove or keep' ) return end select associate ( ws => opts % spaces ) select case ( rule ) case ( 'all' ) ws = whitespace_options_t ( mode , mode , mode , mode , mode , mode , mode , mode , mode , mode , mode , mode , & mode , mode , mode , mode ) case ( 'assignment' ) ws % assignment = mode case ( 'keyword-args' ) ws % keyword_args = mode case ( 'pointer' ) ws % pointer = mode case ( 'declarations' ) ws % declarations = mode case ( 'relational' ) ws % relational = mode case ( 'logical' ) ws % logical = mode case ( 'plus-minus' ) ws % plus_minus = mode case ( 'mult-div' ) ws % mult_div = mode case ( 'power' ) ws % power = mode case ( 'concat' ) ws % concat = mode case ( 'comma' ) ws % comma = mode case ( 'slice-colon' ) ws % slice_colon = mode case ( 'percent' ) ws % percent = mode case ( 'control-paren' ) ws % control_paren = mode case ( 'conditional' ) ws % conditional = mode case ( 'defined-operators' ) ws % defined_operators = mode case default stat = 1 errmsg = 'unknown whitespace rule \"' // rule // '\"' end select end associate end subroutine set_spaces subroutine set_case ( what ) !! Set the letter case of `what` in `opts%letter_case` to the value: `lower`, `upper` or `keep`. character ( len =* ), intent ( in ) :: what !! `keywords`, `operators`, ... or `all`: the key without `case.` integer :: mode select case ( value ) case ( 'lower' ) mode = CASE_LOWER case ( 'upper' ) mode = CASE_UPPER case ( 'keep' ) mode = CASE_KEEP case default call fail ( 'lower, upper or keep' ) return end select select case ( what ) case ( 'all' ) opts % letter_case = case_options_t ( mode , mode , mode , mode , mode ) case ( 'keywords' ) opts % letter_case % keywords = mode case ( 'operators' ) opts % letter_case % operators = mode case ( 'procedures' ) opts % letter_case % procedures = mode case ( 'constants' ) opts % letter_case % constants = mode case ( 'types' ) opts % letter_case % types = mode case default stat = 1 errmsg = 'unknown case setting \"' // what // '\"' end select end subroutine set_case end subroutine apply_setting end module ffmt_settings","tags":"","url":"sourcefile/ffmt_settings.f90.html"},{"title":"ffmt_relational.f90 – fformat","text":"This file depends on sourcefile~~ffmt_relational.f90~~EfferentGraph sourcefile~ffmt_relational.f90 ffmt_relational.f90 sourcefile~ffmt_options.f90 ffmt_options.f90 sourcefile~ffmt_relational.f90->sourcefile~ffmt_options.f90 sourcefile~ffmt_source.f90 ffmt_source.f90 sourcefile~ffmt_relational.f90->sourcefile~ffmt_source.f90 sourcefile~ffmt_statements.f90 ffmt_statements.f90 sourcefile~ffmt_relational.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_strings.f90 ffmt_strings.f90 sourcefile~ffmt_relational.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_tokens.f90 ffmt_tokens.f90 sourcefile~ffmt_relational.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_directives.f90 ffmt_directives.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_directives.f90 sourcefile~ffmt_lexer.f90 ffmt_lexer.f90 sourcefile~ffmt_source.f90->sourcefile~ffmt_lexer.f90 sourcefile~ffmt_statements.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_statements.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_tokens.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_directives.f90->sourcefile~ffmt_statements.f90 sourcefile~ffmt_directives.f90->sourcefile~ffmt_tokens.f90 sourcefile~ffmt_lexer.f90->sourcefile~ffmt_strings.f90 sourcefile~ffmt_lexer.f90->sourcefile~ffmt_tokens.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arro